<Window
    x:Class="DatExplorerIII.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Str.SettingsTitle}"
    Width="520"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--
            A box of the settings: the options one under the other. The label is centered on the box (the theme draws it about two
            pixels low).
        -->
        <Style
            x:Key="OptionBox"
            BasedOn="{StaticResource {x:Type CheckBox}}"
            TargetType="CheckBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0,0,3" />
        </Style>

        <Style
            x:Key="OptionRadio"
            BasedOn="{StaticResource {x:Type RadioButton}}"
            TargetType="RadioButton">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0,0,3" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Margin="16,14,16,12">
            <TabItem x:Name="GeneralTab" Header="{DynamicResource Str.SettingsTabGeneral}">
                <StackPanel Margin="14,14,14,10">
                    <CheckBox
                        x:Name="SingleInstanceBox"
                        Content="{DynamicResource Str.SingleInstance}"
                        IsChecked="{Binding SingleInstance}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="WindowFrameBox"
                        Content="{DynamicResource Str.WindowFrame}"
                        IsChecked="{Binding WindowFrameVisible}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="BlockSeparatorsBox"
                        Content="{DynamicResource Str.BlockSeparators}"
                        IsChecked="{Binding BlockSeparatorsVisible}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="ShowHiddenFoldersBox"
                        Content="{DynamicResource Str.ShowHiddenFolders}"
                        IsChecked="{Binding ShowHiddenFolders}"
                        Style="{StaticResource OptionBox}" />
                    <Separator Margin="0,6" />
                    <CheckBox
                        x:Name="SaveSizeBox"
                        Content="{DynamicResource Str.SettingsSaveSize}"
                        IsChecked="{Binding SaveWindowSize}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="SavePositionBox"
                        Content="{DynamicResource Str.SettingsSavePosition}"
                        IsChecked="{Binding SaveWindowPosition}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="SaveBlocksBox"
                        Content="{DynamicResource Str.SettingsSaveBlocks}"
                        IsChecked="{Binding SaveBlockWidths}"
                        Style="{StaticResource OptionBox}" />
                    <Separator Margin="0,6" />
                    <CheckBox
                        x:Name="SubtitlesBox"
                        Content="{DynamicResource Str.SettingsSubtitles}"
                        IsChecked="{Binding ShowSubtitles}"
                        Style="{StaticResource OptionBox}" />
                    <Separator Margin="0,6" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource Str.SettingsScrollBars}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str.SettingsScrollBarWidth}" />
                        <Slider
                            x:Name="ScrollBarWidthSlider"
                            Grid.Column="1"
                            AutomationProperties.Name="{DynamicResource Str.SettingsScrollBarWidth}"
                            IsSnapToTickEnabled="True"
                            Maximum="32"
                            Minimum="10"
                            TickFrequency="1"
                            Value="{Binding ScrollBarWidth}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{Binding Value, ElementName=ScrollBarWidthSlider, StringFormat={}{0:0} px}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource Str.SettingsScrollBarThumb}"
                            TextWrapping="Wrap" />
                        <Slider
                            x:Name="ScrollBarThumbSlider"
                            Grid.Column="1"
                            AutomationProperties.Name="{DynamicResource Str.SettingsScrollBarThumb}"
                            IsSnapToTickEnabled="True"
                            Maximum="160"
                            Minimum="20"
                            TickFrequency="2"
                            Value="{Binding ScrollBarMinimumThumb}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{Binding Value, ElementName=ScrollBarThumbSlider, StringFormat={}{0:0} px}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="CompareTab" Header="{DynamicResource Str.SettingsTabCompare}">
                <StackPanel Margin="14,14,14,10">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource Str.SettingsIgnore}" />
                    <StackPanel IsEnabled="{Binding IgnoresApply}">
                        <CheckBox
                            x:Name="IgnoreWhitespaceBox"
                            Content="{DynamicResource Str.SettingsIgnoreWhitespace}"
                            IsChecked="{Binding IgnoreWhitespace}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreBlankLinesBox"
                            Content="{DynamicResource Str.SettingsIgnoreBlankLines}"
                            IsChecked="{Binding IgnoreBlankLines}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreCaseBox"
                            Content="{DynamicResource Str.SettingsIgnoreCase}"
                            IsChecked="{Binding IgnoreCase}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreLineEndingsBox"
                            Content="{DynamicResource Str.SettingsIgnoreLineEndings}"
                            IsChecked="{Binding IgnoreLineEndings}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreCodePageBox"
                            Content="{DynamicResource Str.SettingsIgnoreCodePage}"
                            IsChecked="{Binding IgnoreCodePage}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreNumbersBox"
                            Content="{DynamicResource Str.SettingsIgnoreNumbers}"
                            IsChecked="{Binding IgnoreNumbers}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreCommentsBox"
                            Content="{DynamicResource Str.SettingsIgnoreComments}"
                            IsChecked="{Binding IgnoreComments}"
                            Style="{StaticResource OptionBox}" />
                        <CheckBox
                            x:Name="IgnoreFinalEolBox"
                            Content="{DynamicResource Str.SettingsIgnoreFinalEol}"
                            IsChecked="{Binding IgnoreMissingFinalEol}"
                            Style="{StaticResource OptionBox}" />
                    </StackPanel>

                    <Separator Margin="0,6" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource Str.SettingsMethod}" />
                    <RadioButton
                        x:Name="MethodTextButton"
                        MinHeight="26"
                        Content="{DynamicResource Str.SettingsMethodText}"
                        GroupName="Method"
                        IsChecked="{Binding IsTextMethod}"
                        Style="{StaticResource OptionRadio}" />
                    <RadioButton
                        x:Name="MethodBinaryButton"
                        MinHeight="26"
                        Content="{DynamicResource Str.SettingsMethodBinary}"
                        GroupName="Method"
                        IsChecked="{Binding IsBinaryMethod}"
                        Style="{StaticResource OptionRadio}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Opacity="0.7"
                        Text="{DynamicResource Str.SettingsMethodHint}"
                        TextWrapping="Wrap" />

                    <Separator Margin="0,6" />

                    <CheckBox
                        x:Name="SyncScrollBox"
                        Content="{DynamicResource Str.SettingsSyncScroll}"
                        IsChecked="{Binding CompareSyncScroll}"
                        Style="{StaticResource OptionBox}" />
                </StackPanel>
            </TabItem>
            <TabItem x:Name="ExtensionsTab" Header="{DynamicResource Str.SettingsTabExtensions}">
                <Grid Margin="14,14,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        x:Name="ShowAllExtensionsBox"
                        Content="{DynamicResource Str.SettingsShowAllExtensions}"
                        IsChecked="{Binding ShowAllExtensions}"
                        Style="{StaticResource OptionBox}" />
                    <CheckBox
                        x:Name="UnknownAsTextBox"
                        Grid.Row="1"
                        Content="{DynamicResource Str.SettingsUnknownAsText}"
                        IsChecked="{Binding UnknownExtensionsAsText}"
                        Style="{StaticResource OptionBox}" />
                    <Separator Grid.Row="2" Margin="0,6" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource GroupTitle}"
                        Text="{DynamicResource Str.SettingsVisibleExtensions}" />
                    <Grid Grid.Row="4" IsEnabled="{Binding ExtensionsEditable}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <Button
                                x:Name="SelectAllExtensionsButton"
                                MinWidth="88"
                                Click="OnSelectAllExtensions"
                                Content="{DynamicResource Str.SettingsSelectAll}" />
                            <Button
                                x:Name="SelectNoExtensionsButton"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Click="OnSelectNoExtensions"
                                Content="{DynamicResource Str.SettingsSelectNone}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ExtensionsList" ItemsSource="{Binding Extensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Extension}"
                                            IsChecked="{Binding IsVisible}"
                                            Style="{StaticResource OptionBox}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="AssociationsTab" Header="{DynamicResource Str.SettingsTabAssociations}">
                <Grid Margin="14,14,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,10"
                        Opacity="0.7"
                        Text="{DynamicResource Str.SettingsAssociationsHint}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NewExtensionBox"
                            AutomationProperties.Name="{DynamicResource Str.SettingsAssociationExtension}"
                            KeyDown="OnNewExtensionKeyDown"
                            Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str.SettingsAssociationExtension}" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{DynamicResource Str.SettingsAssociationReader}"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Readers}"
                            SelectedItem="{Binding NewReader}" />
                        <Button
                            Grid.Column="2"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            Click="OnAddAssociation"
                            Content="{DynamicResource Str.SettingsAssociationAdd}"
                            IsEnabled="{Binding CanAddAssociation}" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AssociationsList" ItemsSource="{Binding Associations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Extension}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding DataContext.Readers, RelativeSource={RelativeSource AncestorType=Window}}"
                                            SelectedItem="{Binding Reader}" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="{DynamicResource Str.SettingsAssociationRemove}"
                                            Click="OnRemoveAssociation"
                                            ToolTip="{DynamicResource Str.SettingsAssociationRemove}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="LimitsTab" Header="{DynamicResource Str.SettingsTabLimits}">
                <Grid Margin="14,14,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,10"
                        Opacity="0.7"
                        Text="{DynamicResource Str.SettingsLimitsHint}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str.SettingsLimitGlobal}" />
                        <TextBox
                            Grid.Column="1"
                            AutomationProperties.Name="{DynamicResource Str.SettingsLimitGlobal}"
                            Text="{Binding PreviewLimitMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Str.SettingsLimitUnit}" />
                    </Grid>
                    <Separator Grid.Row="2" Margin="0,10" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource GroupTitle}"
                        Text="{DynamicResource Str.SettingsLimitByExtension}" />
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NewLimitExtensionBox"
                                AutomationProperties.Name="{DynamicResource Str.SettingsAssociationExtension}"
                                KeyDown="OnNewLimitKeyDown"
                                Text="{Binding NewLimitExtension, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="{DynamicResource Str.SettingsAssociationExtension}" />
                            <TextBox
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{DynamicResource Str.SettingsLimitGlobal}"
                                KeyDown="OnNewLimitKeyDown"
                                Text="{Binding NewLimitMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Str.SettingsLimitUnit}" />
                            <Button
                                Grid.Column="3"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Click="OnAddLimit"
                                Content="{DynamicResource Str.SettingsAssociationAdd}"
                                IsEnabled="{Binding CanAddLimit}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Limits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Extension}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Text="{Binding Megabytes, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str.SettingsLimitUnit}" />
                                            <Button
                                                Grid.Column="3"
                                                Margin="8,0,0,0"
                                                                AutomationProperties.Name="{DynamicResource Str.SettingsAssociationRemove}"
                                                Click="OnRemoveLimit"
                                                ToolTip="{DynamicResource Str.SettingsAssociationRemove}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="MessagesTab" Header="{DynamicResource Str.SettingsTabMsg}">
                <StackPanel Margin="14,14,14,10">
                    <CheckBox
                        x:Name="DoubleClickProblemsBox"
                        Content="{DynamicResource Str.SettingsMsgDoubleClick}"
                        IsChecked="{Binding DoubleClickMessageProblems}"
                        Style="{StaticResource OptionBox}" />
                    <Separator Margin="0,6" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource Str.SettingsMsgChecks}" />
                    <ItemsControl x:Name="MessageChecksList" ItemsSource="{Binding MessageChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        Opacity="0.7"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Content="{Binding Name}"
                                                    IsChecked="{Binding IsEnabled}"
                                                    Style="{StaticResource OptionBox}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    MinWidth="96"
                    Click="OnOk"
                    Content="{DynamicResource Str.Ok}"
                    IsDefault="True" />
                <Button
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Content="{DynamicResource Str.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>

</Window>