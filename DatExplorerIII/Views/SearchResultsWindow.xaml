<Window x:Class="DatExplorerIII.Views.SearchResultsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource Str.SearchResults}"
		Width="640"
		Height="420"
		MinWidth="360"
		MinHeight="240"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock x:Name="CaptionText" Margin="0,0,0,8" />
		<ListView x:Name="ResultsList"
				  Grid.Row="1"
				  MouseDoubleClick="OnResultActivated"
				  KeyDown="OnResultKeyDown">
			<ListView.View>
				<GridView>
					<GridViewColumn Width="220" Header="{DynamicResource Str.ColName}" DisplayMemberBinding="{Binding Name}" />
					<GridViewColumn Width="360" Header="{DynamicResource Str.ColFolder}" DisplayMemberBinding="{Binding Folder}" />
				</GridView>
			</ListView.View>
		</ListView>
	</Grid>
</Window>