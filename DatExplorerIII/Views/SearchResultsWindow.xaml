<Window
    x:Class="DatExplorerIII.Views.SearchResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    Title="{DynamicResource Str.SearchResults}"
    Width="900"
    Height="640"
    MinWidth="360"
    MinHeight="240"
    FontSize="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <infrastructure:GridViewHeaderOffsetConverter x:Key="GridViewHeaderOffset" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush
            x:Key="SelectedRowBrush"
            Opacity="0.45"
            Color="{x:Static SystemColors.AccentColor}" />

        <SolidColorBrush
            x:Key="HoverRowBrush"
            Opacity="0.18"
            Color="{x:Static SystemColors.AccentColor}" />

        <!--  The header of a column, in the colors of the theme: lower than the one of the theme, with a line under it and a handle to resize the column.  -->
        <Style x:Key="CompactHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border
                                x:Name="Back"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Thumb
                                x:Name="PART_HeaderGripper"
                                Width="7"
                                Margin="0,4,-3,4"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Rectangle
                                                Width="1"
                                                HorizontalAlignment="Center"
                                                Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortArrow" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="9" />
        </Style>

        <!--  A row of the table: close to the next one, with the colors of the main list.  -->
        <Style x:Key="ResultRow" TargetType="ListViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="Row"
                            Height="20"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <GridViewRowPresenter
                                VerticalAlignment="Center"
                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NameCell">
            <StackPanel Margin="8,0,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="12"
                    Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FolderCell">
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Opacity="0.75"
                Text="{Binding Entry.Directory}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SizeCell">
            <TextBlock
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Opacity="0.75"
                Text="{Binding SizeText}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,8"
            Opacity="0.75"
            Text="{Binding Caption}" />
        <ListView
            Grid.Row="1"
            behaviors:ItemActivation.Command="{Binding OpenCommand, Mode=OneTime}"
            behaviors:SortColumn.Command="{Binding SortCommand, Mode=OneTime}"
            ItemContainerStyle="{StaticResource ResultRow}"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem}"
            SelectionMode="Single"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.Resources>
                <!--  The vertical scroll bar starts under the headers of the columns, not along them.  -->
                <Style BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Margin" Value="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource GridViewHeaderOffset}, ConverterParameter=26}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.InputBindings>
                <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
            </ListView.InputBindings>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource CompactHeader}">
                    <GridViewColumn
                        Width="260"
                        behaviors:SortColumn.Key="Name"
                        CellTemplate="{StaticResource NameCell}">
                        <GridViewColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str.ColName}" />
                                <TextBlock Style="{StaticResource SortArrow}" Text="{Binding DataContext.NameSortGlyph, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn
                        Width="260"
                        behaviors:SortColumn.Key="Folder"
                        CellTemplate="{StaticResource FolderCell}">
                        <GridViewColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str.ColFolder}" />
                                <TextBlock Style="{StaticResource SortArrow}" Text="{Binding DataContext.FolderSortGlyph, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn
                        Width="90"
                        behaviors:SortColumn.Key="Size"
                        CellTemplate="{StaticResource SizeCell}">
                        <GridViewColumn.Header>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str.ColSize}" />
                                <TextBlock Style="{StaticResource SortArrow}" Text="{Binding DataContext.SizeSortGlyph, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</Window>
