<Window
    x:Class="DatExplorerIII.Views.SearchResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Str.SearchResults}"
    Width="640"
    Height="420"
    MinWidth="360"
    MinHeight="240"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CaptionText" Margin="0,0,0,8" />
        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            KeyDown="OnResultKeyDown"
            MouseDoubleClick="OnResultActivated">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="220"
                        DisplayMemberBinding="{Binding Name}"
                        Header="{DynamicResource Str.ColName}" />
                    <GridViewColumn
                        Width="360"
                        DisplayMemberBinding="{Binding Folder}"
                        Header="{DynamicResource Str.ColFolder}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</Window>