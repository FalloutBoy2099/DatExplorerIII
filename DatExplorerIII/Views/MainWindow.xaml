<Window
    x:Class="DatExplorerIII.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views"
    Title="{Binding Title}"
    Width="1020"
    Height="690"
    MinWidth="900"
    MinHeight="420"
    behaviors:WindowPlacementBehavior.Store="{Binding}"
    Closed="OnClosed"
    Closing="OnClosing"
    FontSize="12"
    Icon="pack://application:,,,/Resources/app.ico"
    StateChanged="OnStateChanged">

    <Window.InputBindings>
        <KeyBinding
            Key="O"
            Command="{Binding OpenCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding QuickSaveCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="F"
            Command="{Binding FocusSearchCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="P"
            Command="{Binding TogglePreviewCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F3" Command="{Binding ViewItemCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infrastructure:InverseBooleanConverter x:Key="InverseBool" />
        <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infrastructure:BooleanToOrientationConverter x:Key="BoolToOrientation" />

        <!--  Dense layout, like the original application.  -->
        <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
        <SolidColorBrush x:Key="FolderBrush" Color="#FFC83D" />
        <SolidColorBrush
            x:Key="SelectedRowBrush"
            Opacity="0.45"
            Color="{x:Static SystemColors.AccentColor}" />
        <SolidColorBrush
            x:Key="HoverRowBrush"
            Opacity="0.18"
            Color="{x:Static SystemColors.AccentColor}" />

        <!--  Icon of a folder or a file: folders are yellow.  -->
        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                    <Setter Property="Foreground" Value="#E5534B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Rows of the file list: compact, with a simple selection highlight.  -->
        <Style x:Key="FileItemStyle" TargetType="ListViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="Row"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DetailsItemStyle"
            BasedOn="{StaticResource FileItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="Row"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Name column: icon and text.  -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="14"
                    Style="{StaticResource GlyphStyle}"
                    Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!--  Item layouts of the "List" and "Large icons" views.  -->
        <DataTemplate x:Key="ListItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="14"
                    Style="{StaticResource GlyphStyle}"
                    Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="IconItemTemplate">
            <StackPanel Width="84" Margin="1">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="28"
                    Style="{StaticResource GlyphStyle}"
                    Text="{Binding Glyph}" />
                <TextBlock
                    MaxHeight="34"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Text="{Binding Name}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <GridView x:Key="DetailsView">
            <GridViewColumn
                Width="180"
                behaviors:SortColumn.Key="Name"
                CellTemplate="{StaticResource NameCellTemplate}"
                Header="{DynamicResource Str.ColName}" />
            <GridViewColumn
                Width="80"
                behaviors:SortColumn.Key="Type"
                DisplayMemberBinding="{Binding TypeText}"
                Header="{DynamicResource Str.ColType}" />
            <GridViewColumn
                Width="80"
                behaviors:SortColumn.Key="Size"
                DisplayMemberBinding="{Binding SizeText}"
                Header="{DynamicResource Str.ColSize}" />
            <GridViewColumn
                Width="130"
                behaviors:SortColumn.Key="PackedSize"
                DisplayMemberBinding="{Binding PackedSizeText}"
                Header="{DynamicResource Str.ColPacked}" />
        </GridView>

        <ItemsPanelTemplate x:Key="WrapItemsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style
            x:Key="FileListStyle"
            BasedOn="{StaticResource {x:Type ListView}}"
            TargetType="ListView">
            <Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FileItemStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                    <Setter Property="View" Value="{StaticResource DetailsView}" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource DetailsItemStyle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                    <Setter Property="ItemTemplate" Value="{StaticResource IconItemTemplate}" />
                    <Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SearchBoxStyle"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SearchNotFound}" Value="True">
                    <Setter Property="Background" Value="#40FF5050" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The text of a cell of the list of the compared files: in the middle of the line, like the icon of the state.  -->
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  A cell of the list of the compared files: a short line, with its content in the middle (the theme gives the cells room that a list of thousands of files cannot afford).  -->
        <Style
            x:Key="ComparisonCellStyle"
            BasedOn="{StaticResource {x:Type DataGridCell}}"
            TargetType="DataGridCell">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  The numbers of the lines of the differences: small, at the right of their place.  -->
        <Style x:Key="DiffNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!--  The line of a text: what changed, what only one text has.  -->
        <Style
            x:Key="DiffRowStyle"
            BasedOn="{StaticResource {x:Type DataGridRow}}"
            TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ignored">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The tree of the folders of a comparison.  -->
        <Style
            x:Key="ComparisonFolderItemStyle"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <HierarchicalDataTemplate x:Key="ComparisonFolderTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    Foreground="{StaticResource FolderBrush}"
                    Text="&#xF12B;" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding CountText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style
            x:Key="FolderItemStyle"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="14"
                    Style="{StaticResource GlyphStyle}"
                    Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="13"
                    Foreground="#E8A200"
                    Text="&#xE7BA;"
                    ToolTip="{DynamicResource Str.ArchiveHasProblems}"
                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!--  Buttons of the title bar  -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B22A1B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--  The optional frame of the window: a line of the accent color around everything (not when maximized)  -->
    <Border
        x:Name="WindowBorder"
        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
        BorderThickness="0">
        <Grid x:Name="Frame">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title bar in the theme of the application  -->
            <Grid Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="16"
                    Height="16"
                    Margin="10,0,8,0"
                    Source="pack://application:,,,/Resources/app.ico" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        x:Name="ThemeButton"
                        Click="OnThemeButtonClick"
                        Content="&#xE793;"
                        FontSize="14"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource Str.Theme}" />
                    <Button
                        x:Name="LanguageButton"
                        Click="OnLanguageButtonClick"
                        Content="&#xE774;"
                        FontSize="14"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource Str.LanguageTip}" />
                    <Button
                        AutomationProperties.Name="{DynamicResource Str.Minimize}"
                        Click="OnMinimizeClick"
                        Content="&#xE921;"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource Str.Minimize}" />
                    <Button
                        x:Name="MaximizeButton"
                        AutomationProperties.Name="{DynamicResource Str.Maximize}"
                        Click="OnMaximizeClick"
                        Content="&#xE922;"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource Str.Maximize}" />
                    <Button
                        AutomationProperties.Name="{DynamicResource Str.CloseWindow}"
                        Click="OnCloseClick"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="{DynamicResource Str.CloseWindow}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Menu Grid.Row="0" IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}">
                    <MenuItem
                        x:Name="FileMenu"
                        Header="{DynamicResource Str.File}"
                        SubmenuOpened="OnFileMenuOpened">
                        <MenuItem
                            Command="{Binding OpenCommand}"
                            Header="{DynamicResource Str.Open}"
                            InputGestureText="{DynamicResource Str.GestureOpen}" />
                        <MenuItem Command="{Binding OpenFolderCommand}" Header="{DynamicResource Str.OpenFolder}" />
                        <MenuItem Header="{DynamicResource Str.New}">
                            <MenuItem Command="{Binding NewFallout1Command}" Header="{DynamicResource Str.NewFallout1}" />
                            <MenuItem Command="{Binding NewFallout2Command}" Header="{DynamicResource Str.NewFallout2}" />
                            <MenuItem Command="{Binding NewArcanumCommand}" Header="{DynamicResource Str.NewArcanum}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding SaveCommand}"
                            Header="{DynamicResource Str.Save}"
                            InputGestureText="{DynamicResource Str.GestureSave}" />
                        <MenuItem Command="{Binding SaveAsCommand}" Header="{DynamicResource Str.SaveAs}" />
                        <MenuItem
                            Command="{Binding QuickSaveCommand}"
                            Header="{DynamicResource Str.QuickSave}"
                            InputGestureText="{DynamicResource Str.GestureQuickSave}" />
                        <Separator x:Name="CloseSeparator" />
                        <MenuItem Command="{Binding CloseDatCommand}" Header="{DynamicResource Str.CloseDat}" />
                        <Separator />
                        <MenuItem
                            x:Name="ExitMenuItem"
                            Click="OnExit"
                            Header="{DynamicResource Str.Exit}"
                            InputGestureText="{DynamicResource Str.GestureExit}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str.Edit}">
                        <MenuItem
                            Command="{Binding OpenItemCommand}"
                            Header="{DynamicResource Str.OpenItem}"
                            InputGestureText="{DynamicResource Str.GestureOpenItem}" />
                        <MenuItem
                            Command="{Binding ViewItemCommand}"
                            Header="{DynamicResource Str.ViewFile}"
                            InputGestureText="{DynamicResource Str.GestureView}"
                            ToolTip="{DynamicResource Str.ViewFileTip}" />
                        <MenuItem Command="{Binding OpenExternalCommand}" Header="{DynamicResource Str.OpenExternal}" />
                        <Separator />
                        <MenuItem Command="{Binding ExtractItemsCommand}" Header="{DynamicResource Str.ExtractFiles}" />
                        <MenuItem Command="{Binding ExtractFolderCommand}" Header="{DynamicResource Str.ExtractFolder}" />
                        <MenuItem Command="{Binding ExtractAllCommand}" Header="{DynamicResource Str.ExtractAll}" />
                        <Separator />
                        <MenuItem Command="{Binding ImportFilesCommand}" Header="{DynamicResource Str.ImportFiles}" />
                        <MenuItem Command="{Binding ImportFolderCommand}" Header="{DynamicResource Str.ImportFolder}" />
                        <MenuItem Command="{Binding NewFolderCommand}" Header="{DynamicResource Str.NewFolder}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding RenameItemCommand}"
                            Header="{DynamicResource Str.Rename}"
                            InputGestureText="{DynamicResource Str.GestureRename}" />
                        <MenuItem
                            Command="{Binding DeleteItemsCommand}"
                            Header="{DynamicResource Str.Delete}"
                            InputGestureText="{DynamicResource Str.GestureDelete}" />
                        <MenuItem
                            Command="{Binding LowercaseCommand}"
                            Header="{DynamicResource Str.Lowercase}"
                            ToolTip="{DynamicResource Str.LowercaseTip}" />
                        <Separator />
                        <MenuItem Command="{Binding GlobalSearchCommand}" Header="{DynamicResource Str.SearchAll}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str.View}">
                        <MenuItem
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="Details"
                            Header="{DynamicResource Str.ViewDetails}"
                            IsCheckable="True"
                            IsChecked="{Binding IsDetailsView, Mode=OneWay}" />
                        <MenuItem
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="List"
                            Header="{DynamicResource Str.ViewList}"
                            IsCheckable="True"
                            IsChecked="{Binding IsListView, Mode=OneWay}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="Icons"
                            Header="{DynamicResource Str.ViewIcons}"
                            IsCheckable="True"
                            IsChecked="{Binding IsIconsView, Mode=OneWay}" />
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource Str.PreviewPane}"
                            InputGestureText="{DynamicResource Str.GesturePreview}"
                            IsCheckable="True"
                            IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem>
                            <!--  The text starts where the text of the lines with a check mark starts (a title that opens a sub menu has no room for one).  -->
                            <MenuItem.Header>
                                <TextBlock Margin="25.6,0,0,0" Text="{DynamicResource Str.DoubleClickOpens}" />
                            </MenuItem.Header>
                            <MenuItem
                                Command="{Binding SetDoubleClickCommand}"
                                CommandParameter="Viewer"
                                Header="{DynamicResource Str.DoubleClickViewer}"
                                IsCheckable="True"
                                IsChecked="{Binding IsDoubleClickViewer, Mode=OneWay}" />
                            <MenuItem
                                Command="{Binding SetDoubleClickCommand}"
                                CommandParameter="Program"
                                Header="{DynamicResource Str.DoubleClickProgram}"
                                IsCheckable="True"
                                IsChecked="{Binding IsDoubleClickProgram, Mode=OneWay}" />
                            <MenuItem
                                Command="{Binding SetDoubleClickCommand}"
                                CommandParameter="None"
                                Header="{DynamicResource Str.DoubleClickNothing}"
                                IsCheckable="True"
                                IsChecked="{Binding IsDoubleClickNothing, Mode=OneWay}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem>
                            <!--  The text starts where the text of the lines with a check mark starts (a title that opens a sub menu has no room for one).  -->
                            <MenuItem.Header>
                                <TextBlock Margin="25.6,0,0,0" Text="{DynamicResource Str.CompareLayout}" />
                            </MenuItem.Header>
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutListSide}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareListSide}" />
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutListStacked}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareListStacked}" />
                            <Separator />
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutViewersSide}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareViewersSide}" />
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutViewersStacked}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareViewersStacked}" />
                            <Separator />
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutGroupsSide}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareGroupsSide}" />
                            <MenuItem
                                Header="{DynamicResource Str.CompareLayoutGroupsStacked}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareGroupsStacked}" />
                            <Separator />
                            <MenuItem
                                Header="{DynamicResource Str.CompareTree}"
                                IsCheckable="True"
                                IsChecked="{Binding Comparison.IsCompareTreeVisible}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding UpCommand}"
                            Header="{DynamicResource Str.Up}"
                            InputGestureText="{DynamicResource Str.GestureUp}" />
                        <MenuItem
                            Command="{Binding RefreshCommand}"
                            Header="{DynamicResource Str.Refresh}"
                            InputGestureText="{DynamicResource Str.GestureRefresh}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str.Tools}">
                        <MenuItem
                            Command="{Binding VerifyCommand}"
                            Header="{DynamicResource Str.VerifyIntegrity}"
                            ToolTip="{DynamicResource Str.VerifyTip}" />
                        <MenuItem Command="{Binding ShowProblemsCommand}" Header="{DynamicResource Str.ShowProblems}" />
                        <MenuItem
                            Command="{Binding RemoveDamagedCommand}"
                            Header="{DynamicResource Str.RemoveDamaged}"
                            ToolTip="{DynamicResource Str.RemoveDamagedTip}" />
                        <Separator />
                        <MenuItem Command="{Binding Comparison.CompareCommand}" Header="{DynamicResource Str.Compare}" />
                        <MenuItem Command="{Binding Comparison.CloseComparisonCommand}" Header="{DynamicResource Str.CompareClose}" />
                        <Separator />
                        <MenuItem Command="{Binding SettingsCommand}" Header="{DynamicResource Str.Settings}" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str.Help}">
                        <MenuItem Command="{Binding AssociateCommand}" Header="{DynamicResource Str.Associate}" />
                        <MenuItem Command="{Binding AssociatePatchesCommand}" Header="{DynamicResource Str.AssociatePatches}" />
                        <MenuItem Command="{Binding AboutCommand}" Header="{DynamicResource Str.About}" />
                    </MenuItem>
                </Menu>

                <Grid
                    Grid.Row="1"
                    Margin="6,1"
                    IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding Comparison.IsComparing, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  When the window is narrow it is the buttons that are cut, never the search.  -->
                    <StackPanel
                        Grid.Column="0"
                        ClipToBounds="True"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding OpenCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.OpenTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.OpenShort}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NewFallout2Command, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.NewFallout2}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort2}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NewFallout1Command, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.NewFallout1}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort1}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NewArcanumCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.NewArcanum}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShortArcanum}" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="2,4" />
                        <Button
                            Command="{Binding SaveCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.SaveTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Save}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding QuickSaveCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.QuickSaveTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE945;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.QuickSaveShort}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding CloseDatCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.CloseDatTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.CloseShort}" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="2,4" />
                        <Button
                            Command="{Binding UpCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.UpTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74A;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Up}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding ExtractItemsCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.ExtractFilesTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE896;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ExtractShort}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding ImportFilesCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.ImportFilesTip}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE898;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ImportShort}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NewFolderCommand, Mode=OneTime}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="{DynamicResource Str.NewFolder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8F4;" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewFolderShort}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="SearchBox"
                            Width="160"
                            Height="24"
                            VerticalContentAlignment="Center"
                            behaviors:FocusBehavior.Trigger="{Binding SearchFocusRequests}"
                            Style="{StaticResource SearchBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str.SearchTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding FindNextCommand}" />
                                <KeyBinding
                                    Key="Return"
                                    Command="{Binding FindPreviousCommand}"
                                    Modifiers="Shift" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button
                            Height="24"
                            Margin="4,0,0,0"
                            Padding="8,0"
                            Command="{Binding GlobalSearchCommand, Mode=OneTime}"
                            ToolTip="{DynamicResource Str.SearchAll}">
                            <TextBlock
                                FontSize="12"
                                Style="{StaticResource ToolIcon}"
                                Text="&#xE721;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="6,6,6,6"
                    IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding Comparison.IsComparing, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition
                            x:Name="ListColumn"
                            Width="*"
                            MinWidth="240" />
                        <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <TreeView
                        x:Name="FolderTree"
                        Grid.Column="0"
                        behaviors:FileDrag.Source="{Binding FolderDragSource, Mode=OneTime}"
                        behaviors:FileDrop.Command="{Binding OpenDroppedCommand, Mode=OneTime}"
                        behaviors:TreeViewBehavior.SelectOnRightClick="True"
                        behaviors:TreeViewBehavior.SelectedItemCommand="{Binding TreeSelectionChangedCommand, Mode=OneTime}"
                        ItemContainerStyle="{StaticResource FolderItemStyle}"
                        ItemTemplate="{StaticResource FolderTemplate}"
                        ItemsSource="{Binding Roots}">
                        <TreeView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteFolderCommand}" />
                            <KeyBinding Key="F2" Command="{Binding RenameFolderCommand}" />
                        </TreeView.InputBindings>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ExtractFolderCommand}" Header="{DynamicResource Str.ExtractFolder}" />
                                <MenuItem Command="{Binding ExtractAllCommand}" Header="{DynamicResource Str.ExtractAll}" />
                                <Separator />
                                <MenuItem Command="{Binding ImportFolderCommand}" Header="{DynamicResource Str.ImportFolder}" />
                                <MenuItem Command="{Binding NewFolderCommand}" Header="{DynamicResource Str.NewFolder}" />
                                <MenuItem Command="{Binding RenameFolderCommand}" Header="{DynamicResource Str.Rename}" />
                                <MenuItem Command="{Binding DeleteFolderCommand}" Header="{DynamicResource Str.Delete}" />
                                <MenuItem
                                    Command="{Binding LowercaseCommand}"
                                    Header="{DynamicResource Str.Lowercase}"
                                    ToolTip="{DynamicResource Str.LowercaseTip}" />
                                <Separator />
                                <MenuItem Command="{Binding CloseDatCommand}" Header="{DynamicResource Str.CloseDat}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <GridSplitter Grid.Column="1" Style="{StaticResource BlockSplitterStyle}" />

                    <ListView
                        x:Name="FilesList"
                        Grid.Column="2"
                        behaviors:FileDrag.Source="{Binding ListDragSource, Mode=OneTime}"
                        behaviors:FileDrop.Command="{Binding ImportDroppedCommand, Mode=OneTime}"
                        behaviors:GridViewColumnWidths.Widths="{Binding ColumnWidths, Mode=TwoWay}"
                        behaviors:ItemActivation.Command="{Binding OpenItemCommand, Mode=OneTime}"
                        behaviors:SelectionBehavior.Command="{Binding ListSelectionChangedCommand, Mode=OneTime}"
                        behaviors:SortColumn.Command="{Binding SortCommand, Mode=OneTime}"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Extended"
                        Style="{StaticResource FileListStyle}">
                        <ListView.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenItemCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteItemsCommand}" />
                            <KeyBinding Key="F2" Command="{Binding RenameItemCommand}" />
                            <KeyBinding Key="Back" Command="{Binding UpCommand}" />
                        </ListView.InputBindings>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding OpenItemCommand}" Header="{DynamicResource Str.OpenItem}" />
                                <MenuItem
                                    Command="{Binding ViewItemCommand}"
                                    Header="{DynamicResource Str.ViewFile}"
                                    ToolTip="{DynamicResource Str.ViewFileTip}" />
                                <MenuItem Command="{Binding OpenExternalCommand}" Header="{DynamicResource Str.OpenExternal}" />
                                <MenuItem
                                    Command="{Binding ExtractItemsCommand}"
                                    Header="{DynamicResource Str.ExtractFiles}"
                                    ToolTip="{DynamicResource Str.ExtractFilesTip}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding ImportFilesCommand}"
                                    Header="{DynamicResource Str.ImportFiles}"
                                    ToolTip="{DynamicResource Str.ImportFilesTip}" />
                                <MenuItem
                                    Command="{Binding ImportFolderCommand}"
                                    Header="{DynamicResource Str.ImportFolder}"
                                    ToolTip="{DynamicResource Str.ImportFolderTip}" />
                                <MenuItem Command="{Binding NewFolderCommand}" Header="{DynamicResource Str.NewFolder}" />
                                <Separator />
                                <MenuItem Command="{Binding RenameItemCommand}" Header="{DynamicResource Str.Rename}" />
                                <MenuItem
                                    Command="{Binding DeleteItemsCommand}"
                                    Header="{DynamicResource Str.Delete}"
                                    ToolTip="{DynamicResource Str.DeleteTip}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <GridSplitter Grid.Column="3" Style="{StaticResource BlockSplitterStyle}" />

                    <Border
                        Grid.Column="4"
                        Padding="8,0,0,0"
                        DataContext="{Binding Preview}">
                        <views:ViewerControl />
                    </Border>
                </Grid>

                <!--  The comparison of two archives: the same window in another mode.  -->
                <Grid
                    Grid.Row="2"
                    Margin="6,0,6,6"
                    IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding Comparison.IsComparing, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  The tool bar: only icons, the text is the tool tip.  -->
                    <StackPanel Margin="0,-6,0,12" Orientation="Horizontal">
                        <ToggleButton
                            AutomationProperties.Name="{Binding Comparison.Current.DifferentFilterText}"
                            IsChecked="{Binding Comparison.Current.ShowDifferent}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{Binding Comparison.Current.DifferentFilterText}">
                            <TextBlock
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Style="{StaticResource ToolIcon}"
                                Text="&#xE7BA;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{Binding Comparison.Current.LeftOnlyFilterText}"
                            IsChecked="{Binding Comparison.Current.ShowLeftOnly}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{Binding Comparison.Current.LeftOnlyFilterText}">
                            <TextBlock
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource ToolIcon}"
                                Text="&#xE72B;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{Binding Comparison.Current.RightOnlyFilterText}"
                            IsChecked="{Binding Comparison.Current.ShowRightOnly}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{Binding Comparison.Current.RightOnlyFilterText}">
                            <TextBlock
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource ToolIcon}"
                                Text="&#xE72A;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{Binding Comparison.Current.IdenticalFilterText}"
                            IsChecked="{Binding Comparison.Current.ShowIdentical}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{Binding Comparison.Current.IdenticalFilterText}">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource ToolIcon}"
                                Text="&#xE73E;" />
                        </ToggleButton>

                        <Rectangle
                            Width="1"
                            Margin="8,6"
                            Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Opacity="0.5" />

                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareSubfolders}"
                            IsChecked="{Binding Comparison.Current.IncludeSubfolders}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareSubfolders}">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE81E;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareTree}"
                            IsChecked="{Binding Comparison.IsCompareTreeVisible}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareTree}">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A0;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareShowDifferences}"
                            IsChecked="{Binding Comparison.Current.ShowDifferences}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareShowDifferences}">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE746;" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareLayoutListStacked}"
                            IsChecked="{Binding Comparison.IsCompareListStacked}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareLayoutListStacked}">
                            <Path Style="{StaticResource LayoutIconList}" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareLayoutViewersStacked}"
                            IsChecked="{Binding Comparison.IsCompareViewersStacked}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareLayoutViewersStacked}">
                            <Path Style="{StaticResource LayoutIconViewers}" />
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{DynamicResource Str.CompareLayoutGroupsStacked}"
                            IsChecked="{Binding Comparison.IsCompareGroupsStacked}"
                            Style="{StaticResource IconToggle}"
                            ToolTip="{DynamicResource Str.CompareLayoutGroupsStacked}">
                            <Path Style="{StaticResource LayoutIconGroups}" />
                        </ToggleButton>

                        <Rectangle
                            Width="1"
                            Margin="8,6"
                            Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Opacity="0.5" />

                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareCopyLeft}"
                            Command="{Binding Comparison.CopyToLeftCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareCopyLeft}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="12"
                                    Text="&#xE72B;" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16"
                                    Text="&#xE8C8;" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareCopyRight}"
                            Command="{Binding Comparison.CopyToRightCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareCopyRight}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16"
                                    Text="&#xE8C8;" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="12"
                                    Text="&#xE72A;" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareMoveLeft}"
                            Command="{Binding Comparison.MoveToLeftCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareMoveLeft}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="12"
                                    Text="&#xE72B;" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16"
                                    Text="&#xE8C6;" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareMoveRight}"
                            Command="{Binding Comparison.MoveToRightCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareMoveRight}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16"
                                    Text="&#xE8C6;" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="12"
                                    Text="&#xE72A;" />
                            </StackPanel>
                        </Button>

                        <Rectangle
                            Width="1"
                            Margin="8,6"
                            Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Opacity="0.5" />

                        <!--  The bar at the side of the disk tells which archive is saved.  -->
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareSaveLeft}"
                            Command="{Binding Comparison.SaveLeftCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareSaveLeft}">
                            <Border
                                Padding="5,0,0,0"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="3,0,0,0">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                            </Border>
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareSaveRight}"
                            Command="{Binding Comparison.SaveRightCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareSaveRight}">
                            <Border
                                Padding="0,0,5,0"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="0,0,3,0">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                            </Border>
                        </Button>

                        <Rectangle
                            Width="1"
                            Margin="8,6"
                            Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Opacity="0.5" />

                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareAgain}"
                            Command="{Binding Comparison.CompareAgainCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareAgain}">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72C;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Str.CompareClose}"
                            Command="{Binding Comparison.CloseComparisonCommand, Mode=OneTime}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.CompareClose}">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
                        </Button>
                    </StackPanel>

                    <!--  Folders and files, then the two archives: each pair side by side or one above the other, and the two pairs too.  -->
                    <views:SplitPair
                        Grid.Row="1"
                        FirstWeight="1.3"
                        Orientation="{Binding Comparison.IsCompareGroupsStacked, Converter={StaticResource BoolToOrientation}}"
                        SecondWeight="1">
                        <views:SplitPair.First>
                            <views:SplitPair
                                FirstVisible="{Binding Comparison.IsCompareTreeVisible}"
                                FirstWeight="1"
                                Orientation="{Binding Comparison.IsCompareListStacked, Converter={StaticResource BoolToOrientation}}"
                                SecondWeight="2.4">
                                <views:SplitPair.First>
                                    <TreeView
                                        ItemContainerStyle="{StaticResource ComparisonFolderItemStyle}"
                                        ItemTemplate="{StaticResource ComparisonFolderTemplate}"
                                        ItemsSource="{Binding Comparison.Current.Tree}" />
                                </views:SplitPair.First>
                                <views:SplitPair.Second>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <ComboBox
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="{DynamicResource Str.CompareFolderTip}"
                                            DisplayMemberPath="Display"
                                            ItemsSource="{Binding Comparison.Current.FlatFolders}"
                                            SelectedItem="{Binding Comparison.Current.SelectedFolder}"
                                            ToolTip="{DynamicResource Str.CompareFolderTip}" />

                                        <DataGrid
                                            x:Name="ComparisonGrid"
                                            Grid.Row="1"
                                            behaviors:SelectionBehavior.Command="{Binding Comparison.Current.SelectRowsCommand}"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CellStyle="{StaticResource ComparisonCellStyle}"
                                            GridLinesVisibility="Horizontal"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Comparison.Current.Rows}"
                                            RowHeight="20"
                                            SelectionMode="Extended"
                                            SelectionUnit="FullRow">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding Comparison.CopyToLeftCommand}" Header="{DynamicResource Str.CompareCopyLeft}" />
                                                    <MenuItem Command="{Binding Comparison.CopyToRightCommand}" Header="{DynamicResource Str.CompareCopyRight}" />
                                                    <Separator />
                                                    <MenuItem Command="{Binding Comparison.MoveToLeftCommand}" Header="{DynamicResource Str.CompareMoveLeft}" />
                                                    <MenuItem Command="{Binding Comparison.MoveToRightCommand}" Header="{DynamicResource Str.CompareMoveRight}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="150" Header="{DynamicResource Str.CompareStatus}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <TextBlock
                                                                    Width="20"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{StaticResource IconFont}"
                                                                    FontSize="12"
                                                                    LineHeight="14"
                                                                    LineStackingStrategy="BlockLineHeight"
                                                                    Text="{Binding Glyph}"
                                                                    TextAlignment="Center" />
                                                                <TextBlock
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding StateText}" />
                                                                <StackPanel.Resources>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Identical">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Different">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="LeftOnly">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="RightOnly">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Resources>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn
                                                    Width="*"
                                                    MinWidth="160"
                                                    Binding="{Binding Path}"
                                                    ElementStyle="{StaticResource CellTextStyle}"
                                                    Header="{DynamicResource Str.ComparePath}" />
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding LeftSizeText}"
                                                    ElementStyle="{StaticResource CellTextStyle}"
                                                    Header="{DynamicResource Str.CompareLeftSize}" />
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding RightSizeText}"
                                                    ElementStyle="{StaticResource CellTextStyle}"
                                                    Header="{DynamicResource Str.CompareRightSize}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </views:SplitPair.Second>
                            </views:SplitPair>
                        </views:SplitPair.First>

                        <views:SplitPair.Second>
                            <Grid>
                                <Grid Visibility="{Binding Comparison.Current.ShowDifferences, Converter={StaticResource InverseBoolToVisibility}}">
                                    <views:SplitPair Orientation="{Binding Comparison.IsCompareViewersStacked, Converter={StaticResource BoolToOrientation}}">
                                        <views:SplitPair.First>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    Margin="8,0,0,4"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Comparison.Current.LeftTitle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Comparison.Current.LeftToolTip}" />
                                                <Border
                                                    x:Name="LeftViewerHost"
                                                    Grid.Row="1"
                                                    Padding="8,0,0,0"
                                                    behaviors:ScrollSync.IsEnabled="{Binding IsCompareSyncScroll}"
                                                    behaviors:ScrollSync.Partner="{Binding ElementName=RightViewerHost}">
                                                    <views:ViewerControl DataContext="{Binding Comparison.Current.LeftViewer}" />
                                                </Border>
                                            </Grid>
                                        </views:SplitPair.First>
                                        <views:SplitPair.Second>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    Margin="8,0,0,4"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Comparison.Current.RightTitle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Comparison.Current.RightToolTip}" />
                                                <Border
                                                    x:Name="RightViewerHost"
                                                    Grid.Row="1"
                                                    Padding="8,0,0,0"
                                                    behaviors:ScrollSync.IsEnabled="{Binding IsCompareSyncScroll}"
                                                    behaviors:ScrollSync.Partner="{Binding ElementName=LeftViewerHost}">
                                                    <views:ViewerControl DataContext="{Binding Comparison.Current.RightViewer}" />
                                                </Border>
                                            </Grid>
                                        </views:SplitPair.Second>
                                    </views:SplitPair>
                                </Grid>
                                <Grid Visibility="{Binding Comparison.Current.ShowDifferences, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="4,0,0,4" Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.Name="{DynamicResource Str.CompareDiffPrevious}"
                                            Command="{Binding Comparison.Current.Diff.PreviousCommand}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="{DynamicResource Str.CompareDiffPrevious}">
                                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70E;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="{DynamicResource Str.CompareDiffNext}"
                                            Command="{Binding Comparison.Current.Diff.NextCommand}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="{DynamicResource Str.CompareDiffNext}">
                                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70D;" />
                                        </Button>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Comparison.Current.Diff.Summary}" />
                                    </StackPanel>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="4,0,17,2"
                                        Visibility="{Binding Comparison.Current.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{Binding Comparison.Current.LeftTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            FontWeight="SemiBold"
                                            Text="{Binding Comparison.Current.RightTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        Text="{Binding Comparison.Current.Diff.Message}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding Comparison.Current.Diff.HasMessage, Converter={StaticResource BoolToVisibility}}" />

                                    <DataGrid
                                        x:Name="DiffGrid"
                                        Grid.Row="2"
                                        behaviors:ScrollIntoViewBehavior.Enabled="True"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        CanUserReorderColumns="False"
                                        CanUserSortColumns="False"
                                        FontFamily="Consolas"
                                        GridLinesVisibility="None"
                                        HeadersVisibility="None"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Comparison.Current.Diff.Rows}"
                                        RowHeight="20"
                                        RowStyle="{StaticResource DiffRowStyle}"
                                        SelectedItem="{Binding Comparison.Current.Diff.SelectedRow, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        SelectionUnit="FullRow"
                                        Visibility="{Binding Comparison.Current.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="44"
                                                Binding="{Binding LeftNumberText}"
                                                ElementStyle="{StaticResource DiffNumberStyle}" />
                                            <DataGridTextColumn
                                                Width="*"
                                                MinWidth="100"
                                                Binding="{Binding LeftText}" />
                                            <DataGridTextColumn
                                                Width="44"
                                                Binding="{Binding RightNumberText}"
                                                ElementStyle="{StaticResource DiffNumberStyle}" />
                                            <DataGridTextColumn
                                                Width="*"
                                                MinWidth="100"
                                                Binding="{Binding RightText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </views:SplitPair.Second>
                    </views:SplitPair>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        Opacity="0.7"
                        Text="{Binding Comparison.Current.SummaryText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <StatusBar
                    Grid.Row="3"
                    Padding="0"
                    FontSize="11">
                    <StatusBar.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </StatusBar.ItemsPanel>
                    <StatusBarItem Grid.Column="0" Padding="8,2">
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    </StatusBarItem>
                    <StatusBarItem
                        Grid.Column="1"
                        Padding="12,2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <TextBlock Text="{Binding FolderSummary}" />
                    </StatusBarItem>
                    <StatusBarItem
                        Grid.Column="2"
                        Padding="12,2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <TextBlock Text="{Binding PathText}" />
                    </StatusBarItem>
                    <StatusBarItem
                        Grid.Column="3"
                        Padding="12,2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <TextBlock Text="{Binding TotalText}" />
                    </StatusBarItem>
                </StatusBar>

                <!--  Shown while a long operation runs: blocks the window and reports the progress.  -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Background="#99000000"
                    Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        Width="460"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Busy.Title}" />
                            <ProgressBar
                                Height="6"
                                Margin="0,16,0,8"
                                IsIndeterminate="{Binding Busy.IsIndeterminate, Mode=OneWay}"
                                Maximum="{Binding Busy.ProgressMaximum, Mode=OneWay}"
                                Value="{Binding Busy.ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                Height="18"
                                Text="{Binding Busy.Detail}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                MinWidth="88"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding Busy.CancelCommand, Mode=OneTime}"
                                Content="{DynamicResource Str.Cancel}"
                                Visibility="{Binding Busy.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>

</Window>