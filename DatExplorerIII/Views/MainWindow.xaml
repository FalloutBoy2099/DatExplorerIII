<Window x:Class="DatExplorerIII.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
		xmlns:views="clr-namespace:DatExplorerIII.Views"
		xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
		xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
		Title="{Binding Title}"
		Width="1020"
		Height="690"
		MinWidth="760"
		MinHeight="420"
		FontSize="12"
		Icon="pack://application:,,,/Resources/zippedFile.ico"
		Closing="OnClosing"
		StateChanged="OnStateChanged"
		PreviewKeyDown="OnWindowPreviewKeyDown">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<infrastructure:InverseBooleanConverter x:Key="InverseBool" />
		<infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
		<infrastructure:BooleanToOrientationConverter x:Key="BoolToOrientation" />

		<!-- Dense layout, like the original application. -->
		<sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
		<SolidColorBrush x:Key="FolderBrush" Color="#FFC83D" />
		<SolidColorBrush x:Key="SelectedRowBrush" Color="{x:Static SystemColors.AccentColor}" Opacity="0.45" />
		<SolidColorBrush x:Key="HoverRowBrush" Color="{x:Static SystemColors.AccentColor}" Opacity="0.18" />

		<!-- Icon of a folder or a file: folders are yellow. -->
		<Style x:Key="GlyphStyle" TargetType="TextBlock">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsDamaged}" Value="True">
					<Setter Property="Foreground" Value="#E5534B" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsFolder}" Value="True">
					<Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- Rows of the file list: compact, with a simple selection highlight. -->
		<Style x:Key="FileItemStyle" TargetType="ListViewItem">
			<Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DetailsItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileItemStyle}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
							<GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Name column: icon and text. -->
		<DataTemplate x:Key="NameCellTemplate">
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,0,6,0"
						   VerticalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   FontSize="14"
						   Style="{StaticResource GlyphStyle}"
						   Text="{Binding Glyph}" />
				<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
			</StackPanel>
		</DataTemplate>

		<!-- Item layouts of the "List" and "Large icons" views. -->
		<DataTemplate x:Key="ListItemTemplate">
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,0,6,0"
						   VerticalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   FontSize="14"
						   Style="{StaticResource GlyphStyle}"
						   Text="{Binding Glyph}" />
				<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
			</StackPanel>
		</DataTemplate>

		<DataTemplate x:Key="IconItemTemplate">
			<StackPanel Width="84" Margin="1">
				<TextBlock HorizontalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   FontSize="28"
						   Style="{StaticResource GlyphStyle}"
						   Text="{Binding Glyph}" />
				<TextBlock Margin="0,6,0,0"
						   MaxHeight="34"
						   HorizontalAlignment="Center"
						   Text="{Binding Name}"
						   TextAlignment="Center"
						   TextTrimming="CharacterEllipsis"
						   TextWrapping="Wrap" />
			</StackPanel>
		</DataTemplate>

		<GridView x:Key="DetailsView">
			<GridViewColumn Width="300" Header="{DynamicResource Str.ColName}" CellTemplate="{StaticResource NameCellTemplate}" />
			<GridViewColumn Width="90" Header="{DynamicResource Str.ColType}" DisplayMemberBinding="{Binding TypeText}" />
			<GridViewColumn Width="100" Header="{DynamicResource Str.ColSize}" DisplayMemberBinding="{Binding SizeText}" />
			<GridViewColumn Width="150" Header="{DynamicResource Str.ColPacked}" DisplayMemberBinding="{Binding PackedSizeText}" />
		</GridView>

		<ItemsPanelTemplate x:Key="WrapItemsPanel">
			<WrapPanel />
		</ItemsPanelTemplate>

		<Style x:Key="FileListStyle" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
			<Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
			<Setter Property="ItemContainerStyle" Value="{StaticResource FileItemStyle}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding ViewMode}" Value="Details">
					<Setter Property="View" Value="{StaticResource DetailsView}" />
					<Setter Property="ItemContainerStyle" Value="{StaticResource DetailsItemStyle}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding ViewMode}" Value="Icons">
					<Setter Property="ItemTemplate" Value="{StaticResource IconItemTemplate}" />
					<Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
					<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding SearchNotFound}" Value="True">
					<Setter Property="Background" Value="#40FF5050" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- The text of a cell of the list of the compared files: in the middle of the line, like the icon of the state. -->
		<Style x:Key="CellTextStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- The numbers of the lines of the differences: small, at the right of their place. -->
		<Style x:Key="DiffNumberStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="Opacity" Value="0.55" />
		</Style>

		<!-- The line of a text: what changed, what only one text has. -->
		<Style x:Key="DiffRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
			<Setter Property="Background" Value="Transparent" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Kind}" Value="Changed">
					<Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
					<Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Kind}" Value="RightOnly">
					<Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Kind}" Value="Ignored">
					<Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- The tree of the folders of a comparison. -->
		<Style x:Key="ComparisonFolderItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
			<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
			<Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
			<Setter Property="MinHeight" Value="20" />
			<Setter Property="Padding" Value="2,0" />
		</Style>

		<HierarchicalDataTemplate x:Key="ComparisonFolderTemplate" ItemsSource="{Binding Children}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,0,6,0"
						   VerticalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   Foreground="{StaticResource FolderBrush}"
						   Text="&#xF12B;" />
				<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
				<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding CountText}" />
			</StackPanel>
		</HierarchicalDataTemplate>

		<Style x:Key="FolderItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
			<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
			<Setter Property="ToolTip" Value="{Binding ToolTip}" />
			<Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
			<Setter Property="MinHeight" Value="20" />
			<Setter Property="Padding" Value="2,0" />
		</Style>

		<HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,0,6,0"
						   VerticalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   FontSize="14"
						   Style="{StaticResource GlyphStyle}"
						   Text="{Binding Glyph}" />
				<TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsRoot}" Value="True">
									<Setter Property="FontWeight" Value="SemiBold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
				<TextBlock Margin="6,0,0,0"
						   VerticalAlignment="Center"
						   FontFamily="{StaticResource IconFont}"
						   FontSize="13"
						   Foreground="#E8A200"
						   Text="&#xE7BA;"
						   ToolTip="{DynamicResource Str.ArchiveHasProblems}"
						   Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
			</StackPanel>
		</HierarchicalDataTemplate>

		<!-- Buttons of the title bar -->
		<Style x:Key="CaptionButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="46" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="FontFamily" Value="{StaticResource IconFont}" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
			<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Chrome" Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Chrome" Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#B22A1B" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="32"
			ResizeBorderThickness="6"
			GlassFrameThickness="0"
			CornerRadius="0"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<!-- The optional frame of the window: a line of the accent color around everything (not when maximized) -->
	<Border x:Name="WindowBorder" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0">
	<Grid x:Name="Frame">
		<Grid.RowDefinitions>
			<RowDefinition Height="32" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Title bar in the theme of the application -->
		<Grid Background="{DynamicResource LayerFillColorDefaultBrush}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Image Source="pack://application:,,,/Resources/zippedFile.ico" Width="16" Height="16" Margin="10,0,8,0" />
			<TextBlock Grid.Column="1"
				Text="{Binding Title}"
				VerticalAlignment="Center"
				TextTrimming="CharacterEllipsis"
				Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<Button x:Name="ThemeButton"
					Style="{StaticResource CaptionButtonStyle}"
					Content="&#xE790;"
					FontSize="14"
					Click="OnThemeButtonClick"
					ToolTip="{DynamicResource Str.Theme}" />
				<Button x:Name="LanguageButton"
					Style="{StaticResource CaptionButtonStyle}"
					Content="&#xE774;"
					FontSize="14"
					Click="OnLanguageButtonClick"
					ToolTip="{DynamicResource Str.LanguageTip}" />
				<Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="{DynamicResource Str.Minimize}" AutomationProperties.Name="{DynamicResource Str.Minimize}" />
				<Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="{DynamicResource Str.Maximize}" AutomationProperties.Name="{DynamicResource Str.Maximize}" />
				<Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="{DynamicResource Str.CloseWindow}" AutomationProperties.Name="{DynamicResource Str.CloseWindow}" />
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Menu Grid.Row="0" IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}">
				<MenuItem x:Name="FileMenu" Header="{DynamicResource Str.File}" SubmenuOpened="OnFileMenuOpened">
					<MenuItem Header="{DynamicResource Str.Open}" Command="{Binding OpenCommand}" InputGestureText="{DynamicResource Str.GestureOpen}" />
					<MenuItem Header="{DynamicResource Str.OpenFolder}" Command="{Binding OpenFolderCommand}" />
					<MenuItem Header="{DynamicResource Str.New}">
						<MenuItem Header="{DynamicResource Str.NewFallout1}" Command="{Binding NewFallout1Command}" />
						<MenuItem Header="{DynamicResource Str.NewFallout2}" Command="{Binding NewFallout2Command}" />
						<MenuItem Header="{DynamicResource Str.NewArcanum}" Command="{Binding NewArcanumCommand}" />
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Str.Save}" Command="{Binding SaveCommand}" InputGestureText="{DynamicResource Str.GestureSave}" />
					<MenuItem Header="{DynamicResource Str.SaveAs}" Command="{Binding SaveAsCommand}" />
					<MenuItem Header="{DynamicResource Str.QuickSave}" Command="{Binding QuickSaveCommand}" InputGestureText="{DynamicResource Str.GestureQuickSave}" />
					<Separator x:Name="CloseSeparator" />
					<MenuItem Header="{DynamicResource Str.CloseDat}" Command="{Binding CloseDatCommand}" />
					<Separator />
					<MenuItem x:Name="ExitMenuItem" Header="{DynamicResource Str.Exit}" Click="OnExit" InputGestureText="{DynamicResource Str.GestureExit}" />
				</MenuItem>
				<MenuItem Header="{DynamicResource Str.Edit}">
					<MenuItem Header="{DynamicResource Str.OpenItem}" Command="{Binding OpenItemCommand}" InputGestureText="{DynamicResource Str.GestureOpenItem}" />
					<MenuItem Header="{DynamicResource Str.ViewFile}" Command="{Binding ViewItemCommand}" InputGestureText="{DynamicResource Str.GestureView}" ToolTip="{DynamicResource Str.ViewFileTip}" />
					<MenuItem Header="{DynamicResource Str.OpenExternal}" Command="{Binding OpenExternalCommand}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.ExtractFiles}" Command="{Binding ExtractItemsCommand}" />
					<MenuItem Header="{DynamicResource Str.ExtractFolder}" Command="{Binding ExtractFolderCommand}" />
					<MenuItem Header="{DynamicResource Str.ExtractAll}" Command="{Binding ExtractAllCommand}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.ImportFiles}" Command="{Binding ImportFilesCommand}" />
					<MenuItem Header="{DynamicResource Str.ImportFolder}" Command="{Binding ImportFolderCommand}" />
					<MenuItem Header="{DynamicResource Str.NewFolder}" Command="{Binding NewFolderCommand}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.Rename}" Command="{Binding RenameItemCommand}" InputGestureText="{DynamicResource Str.GestureRename}" />
					<MenuItem Header="{DynamicResource Str.Delete}" Command="{Binding DeleteItemsCommand}" InputGestureText="{DynamicResource Str.GestureDelete}" />
					<MenuItem Header="{DynamicResource Str.Lowercase}" Command="{Binding LowercaseCommand}" ToolTip="{DynamicResource Str.LowercaseTip}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.SearchAll}" Command="{Binding GlobalSearchCommand}" />
				</MenuItem>
				<MenuItem Header="{DynamicResource Str.View}">
					<MenuItem Header="{DynamicResource Str.ViewDetails}" IsCheckable="True" IsChecked="{Binding IsDetailsView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="Details" />
					<MenuItem Header="{DynamicResource Str.ViewList}" IsCheckable="True" IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="List" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.ViewIcons}" IsCheckable="True" IsChecked="{Binding IsIconsView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="Icons" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.PreviewPane}" IsCheckable="True" IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}" InputGestureText="{DynamicResource Str.GesturePreview}" />
					<Separator />
					<MenuItem>
						<!-- The text starts where the text of the lines with a check mark starts (a title that opens a sub menu has no room for one). -->
						<MenuItem.Header>
							<TextBlock Margin="25.6,0,0,0" Text="{DynamicResource Str.DoubleClickOpens}" />
						</MenuItem.Header>
						<MenuItem Header="{DynamicResource Str.DoubleClickViewer}" IsCheckable="True" IsChecked="{Binding IsDoubleClickViewer, Mode=OneWay}" Command="{Binding SetDoubleClickCommand}" CommandParameter="Viewer" />
						<MenuItem Header="{DynamicResource Str.DoubleClickProgram}" IsCheckable="True" IsChecked="{Binding IsDoubleClickProgram, Mode=OneWay}" Command="{Binding SetDoubleClickCommand}" CommandParameter="Program" />
						<MenuItem Header="{DynamicResource Str.DoubleClickNothing}" IsCheckable="True" IsChecked="{Binding IsDoubleClickNothing, Mode=OneWay}" Command="{Binding SetDoubleClickCommand}" CommandParameter="None" />
					</MenuItem>
					<Separator />
					<MenuItem>
						<!-- The text starts where the text of the lines with a check mark starts (a title that opens a sub menu has no room for one). -->
						<MenuItem.Header>
							<TextBlock Margin="25.6,0,0,0" Text="{DynamicResource Str.CompareLayout}" />
						</MenuItem.Header>
						<MenuItem Header="{DynamicResource Str.CompareLayoutListSide}" IsCheckable="True" IsChecked="{Binding IsCompareListSide}" />
						<MenuItem Header="{DynamicResource Str.CompareLayoutListStacked}" IsCheckable="True" IsChecked="{Binding IsCompareListStacked}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.CompareLayoutViewersSide}" IsCheckable="True" IsChecked="{Binding IsCompareViewersSide}" />
						<MenuItem Header="{DynamicResource Str.CompareLayoutViewersStacked}" IsCheckable="True" IsChecked="{Binding IsCompareViewersStacked}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.CompareLayoutGroupsSide}" IsCheckable="True" IsChecked="{Binding IsCompareGroupsSide}" />
						<MenuItem Header="{DynamicResource Str.CompareLayoutGroupsStacked}" IsCheckable="True" IsChecked="{Binding IsCompareGroupsStacked}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.CompareTree}" IsCheckable="True" IsChecked="{Binding IsCompareTreeVisible}" />
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Str.Up}" Command="{Binding UpCommand}" InputGestureText="{DynamicResource Str.GestureUp}" />
					<MenuItem Header="{DynamicResource Str.Refresh}" Command="{Binding RefreshCommand}" InputGestureText="{DynamicResource Str.GestureRefresh}" />
				</MenuItem>
				<MenuItem Header="{DynamicResource Str.Tools}">
					<MenuItem Header="{DynamicResource Str.VerifyIntegrity}" Command="{Binding VerifyCommand}" ToolTip="{DynamicResource Str.VerifyTip}" />
					<MenuItem Header="{DynamicResource Str.ShowProblems}" Command="{Binding ShowProblemsCommand}" />
					<MenuItem Header="{DynamicResource Str.RemoveDamaged}" Command="{Binding RemoveDamagedCommand}" ToolTip="{DynamicResource Str.RemoveDamagedTip}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.Compare}" Command="{Binding CompareCommand}" />
					<MenuItem Header="{DynamicResource Str.CompareClose}" Command="{Binding CloseComparisonCommand}" />
					<Separator />
					<MenuItem Header="{DynamicResource Str.Settings}" Command="{Binding SettingsCommand}" />
				</MenuItem>
				<MenuItem Header="{DynamicResource Str.Help}">
					<MenuItem Header="{DynamicResource Str.Associate}" Command="{Binding AssociateCommand}" />
					<MenuItem Header="{DynamicResource Str.AssociatePatches}" Command="{Binding AssociatePatchesCommand}" />
					<MenuItem Header="{DynamicResource Str.About}" Command="{Binding AboutCommand}" />
				</MenuItem>
			</Menu>

			<Grid Grid.Row="1" Margin="6,1" IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding IsComparing, Converter={StaticResource InverseBoolToVisibility}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="{DynamicResource Str.OpenTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.OpenShort}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding NewFallout2Command}" ToolTip="{DynamicResource Str.NewFallout2}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort2}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding NewFallout1Command}" ToolTip="{DynamicResource Str.NewFallout1}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort1}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding NewArcanumCommand}" ToolTip="{DynamicResource Str.NewArcanum}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShortArcanum}" />
						</StackPanel>
					</Button>
					<Separator Margin="2,4" />
					<Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="{DynamicResource Str.SaveTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Save}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding QuickSaveCommand}" ToolTip="{DynamicResource Str.QuickSaveTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE945;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.QuickSaveShort}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding CloseDatCommand}" ToolTip="{DynamicResource Str.CloseDatTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.CloseShort}" />
						</StackPanel>
					</Button>
					<Separator Margin="2,4" />
					<Button Style="{StaticResource ToolButton}" Command="{Binding UpCommand}" ToolTip="{DynamicResource Str.UpTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74A;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Up}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding ExtractItemsCommand}" ToolTip="{DynamicResource Str.ExtractFilesTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE896;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ExtractShort}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding ImportFilesCommand}" ToolTip="{DynamicResource Str.ImportFilesTip}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE898;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ImportShort}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}" ToolTip="{DynamicResource Str.NewFolder}">
						<StackPanel>
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8F4;" />
							<TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewFolderShort}" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBox x:Name="SearchBox"
							 Width="180"
							 Height="24"
							 VerticalContentAlignment="Center"
							 Style="{StaticResource SearchBoxStyle}"
							 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
							 ToolTip="{DynamicResource Str.SearchTip}"
							 KeyDown="OnSearchKeyDown" />
					<Button Margin="4,0,0,0"
							Height="24"
							Padding="8,0"
							Command="{Binding GlobalSearchCommand}"
							ToolTip="{DynamicResource Str.SearchAll}">
						<TextBlock Style="{StaticResource ToolIcon}" FontSize="12" Text="&#xE721;" />
					</Button>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="2" Margin="6,6,6,6" IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding IsComparing, Converter={StaticResource InverseBoolToVisibility}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="280" MinWidth="160" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="240" />
					<ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" />
					<ColumnDefinition x:Name="PreviewColumn" Width="0" />
				</Grid.ColumnDefinitions>

				<TreeView x:Name="FolderTree"
						  Grid.Column="0"
						  AllowDrop="True"
						  ItemContainerStyle="{StaticResource FolderItemStyle}"
						  ItemTemplate="{StaticResource FolderTemplate}"
						  ItemsSource="{Binding Roots}"
						  DragOver="OnTreeDragOver"
						  Drop="OnTreeDrop"
						  PreviewMouseLeftButtonDown="OnTreePreviewMouseDown"
						  PreviewMouseRightButtonDown="OnTreePreviewRightMouseDown"
						  PreviewMouseMove="OnTreePreviewMouseMove"
						  SelectedItemChanged="OnTreeSelectedItemChanged"
						  PreviewKeyDown="OnTreeKeyDown">
					<TreeView.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{DynamicResource Str.ExtractFolder}" Command="{Binding ExtractFolderCommand}" />
							<MenuItem Header="{DynamicResource Str.ExtractAll}" Command="{Binding ExtractAllCommand}" />
							<Separator />
							<MenuItem Header="{DynamicResource Str.ImportFolder}" Command="{Binding ImportFolderCommand}" />
							<MenuItem Header="{DynamicResource Str.NewFolder}" Command="{Binding NewFolderCommand}" />
							<MenuItem Header="{DynamicResource Str.Rename}" Command="{Binding RenameFolderCommand}" />
							<MenuItem Header="{DynamicResource Str.Delete}" Command="{Binding DeleteFolderCommand}" />
							<MenuItem Header="{DynamicResource Str.Lowercase}" Command="{Binding LowercaseCommand}" ToolTip="{DynamicResource Str.LowercaseTip}" />
							<Separator />
							<MenuItem Header="{DynamicResource Str.CloseDat}" Command="{Binding CloseDatCommand}" />
						</ContextMenu>
					</TreeView.ContextMenu>
				</TreeView>

				<GridSplitter Grid.Column="1" Style="{StaticResource BlockSplitterStyle}" />

				<ListView x:Name="FilesList"
						  Grid.Column="2"
						  AllowDrop="True"
						  ItemsSource="{Binding Items}"
						  SelectionMode="Extended"
						  Style="{StaticResource FileListStyle}"
						  DragOver="OnListDragOver"
						  Drop="OnListDrop"
						  GridViewColumnHeader.Click="OnColumnHeaderClick"
						  KeyDown="OnListKeyDown"
						  MouseDoubleClick="OnListDoubleClick"
						  PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
						  PreviewMouseMove="OnListPreviewMouseMove"
						  SelectionChanged="OnListSelectionChanged">
					<ListView.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{DynamicResource Str.OpenItem}" Command="{Binding OpenItemCommand}" />
							<MenuItem Header="{DynamicResource Str.ViewFile}" Command="{Binding ViewItemCommand}" ToolTip="{DynamicResource Str.ViewFileTip}" />
							<MenuItem Header="{DynamicResource Str.OpenExternal}" Command="{Binding OpenExternalCommand}" />
							<MenuItem Header="{DynamicResource Str.ExtractFiles}" Command="{Binding ExtractItemsCommand}" ToolTip="{DynamicResource Str.ExtractFilesTip}" />
							<Separator />
							<MenuItem Header="{DynamicResource Str.ImportFiles}" Command="{Binding ImportFilesCommand}" ToolTip="{DynamicResource Str.ImportFilesTip}" />
							<MenuItem Header="{DynamicResource Str.ImportFolder}" Command="{Binding ImportFolderCommand}" ToolTip="{DynamicResource Str.ImportFolderTip}" />
							<MenuItem Header="{DynamicResource Str.NewFolder}" Command="{Binding NewFolderCommand}" />
							<Separator />
							<MenuItem Header="{DynamicResource Str.Rename}" Command="{Binding RenameItemCommand}" />
							<MenuItem Header="{DynamicResource Str.Delete}" Command="{Binding DeleteItemsCommand}" ToolTip="{DynamicResource Str.DeleteTip}" />
						</ContextMenu>
					</ListView.ContextMenu>
				</ListView>

				<GridSplitter Grid.Column="3" Style="{StaticResource BlockSplitterStyle}" />

				<Border Grid.Column="4" Padding="8,0,0,0" DataContext="{Binding Preview}">
					<views:ViewerControl />
				</Border>
			</Grid>

			<!-- The comparison of two archives: the same window in another mode. -->
			<Grid Grid.Row="2"
				  Margin="6,0,6,6"
				  IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
				  Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- The tool bar: only icons, the text is the tool tip. -->
				<StackPanel Margin="0,-6,0,12" Orientation="Horizontal">
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.ShowDifferent}" ToolTip="{Binding Comparison.DifferentFilterText}" AutomationProperties.Name="{Binding Comparison.DifferentFilterText}">
						<TextBlock Style="{StaticResource ToolIcon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="&#xE7BA;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.ShowLeftOnly}" ToolTip="{Binding Comparison.LeftOnlyFilterText}" AutomationProperties.Name="{Binding Comparison.LeftOnlyFilterText}">
						<TextBlock Style="{StaticResource ToolIcon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE72B;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.ShowRightOnly}" ToolTip="{Binding Comparison.RightOnlyFilterText}" AutomationProperties.Name="{Binding Comparison.RightOnlyFilterText}">
						<TextBlock Style="{StaticResource ToolIcon}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="&#xE72A;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.ShowIdentical}" ToolTip="{Binding Comparison.IdenticalFilterText}" AutomationProperties.Name="{Binding Comparison.IdenticalFilterText}">
						<TextBlock Style="{StaticResource ToolIcon}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE73E;" />
					</ToggleButton>

					<Rectangle Width="1" Margin="8,6" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.IncludeSubfolders}" ToolTip="{DynamicResource Str.CompareSubfolders}" AutomationProperties.Name="{DynamicResource Str.CompareSubfolders}">
						<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE81E;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsCompareTreeVisible}" ToolTip="{DynamicResource Str.CompareTree}" AutomationProperties.Name="{DynamicResource Str.CompareTree}">
						<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A0;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Comparison.ShowDifferences}" ToolTip="{DynamicResource Str.CompareShowDifferences}" AutomationProperties.Name="{DynamicResource Str.CompareShowDifferences}">
						<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE746;" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsCompareListStacked}" ToolTip="{DynamicResource Str.CompareLayoutListStacked}" AutomationProperties.Name="{DynamicResource Str.CompareLayoutListStacked}">
						<Path Style="{StaticResource LayoutIconList}" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsCompareViewersStacked}" ToolTip="{DynamicResource Str.CompareLayoutViewersStacked}" AutomationProperties.Name="{DynamicResource Str.CompareLayoutViewersStacked}">
						<Path Style="{StaticResource LayoutIconViewers}" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsCompareGroupsStacked}" ToolTip="{DynamicResource Str.CompareLayoutGroupsStacked}" AutomationProperties.Name="{DynamicResource Str.CompareLayoutGroupsStacked}">
						<Path Style="{StaticResource LayoutIconGroups}" />
					</ToggleButton>

					<Rectangle Width="1" Margin="8,6" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

					<Button Style="{StaticResource IconButton}" Command="{Binding CopyToLeftCommand}" ToolTip="{DynamicResource Str.CompareCopyLeft}" AutomationProperties.Name="{DynamicResource Str.CompareCopyLeft}">
						<StackPanel Orientation="Horizontal">
							<TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE72B;" />
							<TextBlock Margin="2,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8C8;" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource IconButton}" Command="{Binding CopyToRightCommand}" ToolTip="{DynamicResource Str.CompareCopyRight}" AutomationProperties.Name="{DynamicResource Str.CompareCopyRight}">
						<StackPanel Orientation="Horizontal">
							<TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8C8;" />
							<TextBlock Margin="2,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE72A;" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource IconButton}" Command="{Binding MoveToLeftCommand}" ToolTip="{DynamicResource Str.CompareMoveLeft}" AutomationProperties.Name="{DynamicResource Str.CompareMoveLeft}">
						<StackPanel Orientation="Horizontal">
							<TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE72B;" />
							<TextBlock Margin="2,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8C6;" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource IconButton}" Command="{Binding MoveToRightCommand}" ToolTip="{DynamicResource Str.CompareMoveRight}" AutomationProperties.Name="{DynamicResource Str.CompareMoveRight}">
						<StackPanel Orientation="Horizontal">
							<TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8C6;" />
							<TextBlock Margin="2,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE72A;" />
						</StackPanel>
					</Button>

					<Rectangle Width="1" Margin="8,6" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

					<!-- The bar at the side of the disk tells which archive is saved. -->
					<Button Style="{StaticResource IconButton}" Command="{Binding SaveLeftCommand}" ToolTip="{DynamicResource Str.CompareSaveLeft}" AutomationProperties.Name="{DynamicResource Str.CompareSaveLeft}">
						<Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Padding="5,0,0,0">
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
						</Border>
					</Button>
					<Button Style="{StaticResource IconButton}" Command="{Binding SaveRightCommand}" ToolTip="{DynamicResource Str.CompareSaveRight}" AutomationProperties.Name="{DynamicResource Str.CompareSaveRight}">
						<Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0,0,3,0" Padding="0,0,5,0">
							<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
						</Border>
					</Button>

					<Rectangle Width="1" Margin="8,6" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

					<Button Style="{StaticResource IconButton}" Command="{Binding CompareAgainCommand}" ToolTip="{DynamicResource Str.CompareAgain}" AutomationProperties.Name="{DynamicResource Str.CompareAgain}">
						<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72C;" />
					</Button>
					<Button Style="{StaticResource IconButton}" Command="{Binding CloseComparisonCommand}" ToolTip="{DynamicResource Str.CompareClose}" AutomationProperties.Name="{DynamicResource Str.CompareClose}">
						<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
					</Button>
				</StackPanel>

				<!-- Folders and files, then the two archives: each pair side by side or one above the other, and the two pairs too. -->
				<views:SplitPair Grid.Row="1"
								 FirstWeight="1.3"
								 SecondWeight="1"
								 Orientation="{Binding IsCompareGroupsStacked, Converter={StaticResource BoolToOrientation}}">
					<views:SplitPair.First>
						<views:SplitPair FirstVisible="{Binding IsCompareTreeVisible}"
										 FirstWeight="1"
										 SecondWeight="2.4"
										 Orientation="{Binding IsCompareListStacked, Converter={StaticResource BoolToOrientation}}">
							<views:SplitPair.First>
								<TreeView ItemContainerStyle="{StaticResource ComparisonFolderItemStyle}"
										  ItemTemplate="{StaticResource ComparisonFolderTemplate}"
										  ItemsSource="{Binding Comparison.Tree}" />
							</views:SplitPair.First>
							<views:SplitPair.Second>
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>

									<ComboBox Margin="0,0,0,4"
											  HorizontalAlignment="Stretch"
											  DisplayMemberPath="Display"
											  ItemsSource="{Binding Comparison.FlatFolders}"
											  SelectedItem="{Binding Comparison.SelectedFolder}"
											  ToolTip="{DynamicResource Str.CompareFolderTip}"
											  AutomationProperties.Name="{DynamicResource Str.CompareFolderTip}" />

									<DataGrid x:Name="ComparisonGrid"
											  Grid.Row="1"
											  AutoGenerateColumns="False"
											  CanUserAddRows="False"
											  CanUserDeleteRows="False"
											  GridLinesVisibility="Horizontal"
											  HeadersVisibility="Column"
											  IsReadOnly="True"
											  ItemsSource="{Binding Comparison.Rows}"
											  RowHeight="24"
											  SelectionChanged="OnComparisonSelectionChanged"
											  SelectionMode="Extended"
											  SelectionUnit="FullRow">
										<DataGrid.ContextMenu>
											<ContextMenu>
												<MenuItem Header="{DynamicResource Str.CompareCopyLeft}" Command="{Binding CopyToLeftCommand}" />
												<MenuItem Header="{DynamicResource Str.CompareCopyRight}" Command="{Binding CopyToRightCommand}" />
												<Separator />
												<MenuItem Header="{DynamicResource Str.CompareMoveLeft}" Command="{Binding MoveToLeftCommand}" />
												<MenuItem Header="{DynamicResource Str.CompareMoveRight}" Command="{Binding MoveToRightCommand}" />
											</ContextMenu>
										</DataGrid.ContextMenu>
										<DataGrid.Columns>
											<DataGridTemplateColumn Width="150" Header="{DynamicResource Str.CompareStatus}">
												<DataGridTemplateColumn.CellTemplate>
													<DataTemplate>
														<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
															<TextBlock Width="24" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="14" Text="{Binding Glyph}" TextAlignment="Center" />
															<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding StateText}" />
															<StackPanel.Resources>
																<Style TargetType="TextBlock">
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding State}" Value="Identical">
																			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
																		</DataTrigger>
																		<DataTrigger Binding="{Binding State}" Value="Different">
																			<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
																		</DataTrigger>
																		<DataTrigger Binding="{Binding State}" Value="LeftOnly">
																			<Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
																		</DataTrigger>
																		<DataTrigger Binding="{Binding State}" Value="RightOnly">
																			<Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</StackPanel.Resources>
														</StackPanel>
													</DataTemplate>
												</DataGridTemplateColumn.CellTemplate>
											</DataGridTemplateColumn>
											<DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Width="*" MinWidth="160" Binding="{Binding Path}" Header="{DynamicResource Str.ComparePath}" />
											<DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Width="Auto" Binding="{Binding LeftSizeText}" Header="{DynamicResource Str.CompareLeftSize}" />
											<DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Width="Auto" Binding="{Binding RightSizeText}" Header="{DynamicResource Str.CompareRightSize}" />
										</DataGrid.Columns>
									</DataGrid>
								</Grid>
							</views:SplitPair.Second>
						</views:SplitPair>
					</views:SplitPair.First>

					<views:SplitPair.Second>
						<Grid>
							<Grid Visibility="{Binding Comparison.ShowDifferences, Converter={StaticResource InverseBoolToVisibility}}">
							<views:SplitPair Orientation="{Binding IsCompareViewersStacked, Converter={StaticResource BoolToOrientation}}">
								<views:SplitPair.First>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<TextBlock Margin="8,0,0,4" FontWeight="SemiBold" Text="{Binding Comparison.LeftTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comparison.LeftToolTip}" />
										<Border x:Name="LeftViewerHost" Grid.Row="1" Padding="8,0,0,0" ScrollViewer.ScrollChanged="OnViewerScrollChanged">
											<views:ViewerControl DataContext="{Binding Comparison.LeftViewer}" />
										</Border>
									</Grid>
								</views:SplitPair.First>
								<views:SplitPair.Second>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<TextBlock Margin="8,0,0,4" FontWeight="SemiBold" Text="{Binding Comparison.RightTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comparison.RightToolTip}" />
										<Border x:Name="RightViewerHost" Grid.Row="1" Padding="8,0,0,0" ScrollViewer.ScrollChanged="OnViewerScrollChanged">
											<views:ViewerControl DataContext="{Binding Comparison.RightViewer}" />
										</Border>
									</Grid>
								</views:SplitPair.Second>
							</views:SplitPair>
							</Grid>
								<Grid Visibility="{Binding Comparison.ShowDifferences, Converter={StaticResource BoolToVisibility}}">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>

									<StackPanel Margin="4,0,0,4" Orientation="Horizontal">
										<Button Style="{StaticResource IconButton}" Command="{Binding Comparison.Diff.PreviousCommand}" ToolTip="{DynamicResource Str.CompareDiffPrevious}" AutomationProperties.Name="{DynamicResource Str.CompareDiffPrevious}">
											<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70E;" />
										</Button>
										<Button Style="{StaticResource IconButton}" Command="{Binding Comparison.Diff.NextCommand}" ToolTip="{DynamicResource Str.CompareDiffNext}" AutomationProperties.Name="{DynamicResource Str.CompareDiffNext}">
											<TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70D;" />
										</Button>
										<TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Comparison.Diff.Summary}" />
									</StackPanel>

									<Grid Grid.Row="1" Margin="4,0,17,2" Visibility="{Binding Comparison.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="44" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="44" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Comparison.LeftTitle}" TextTrimming="CharacterEllipsis" />
										<TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding Comparison.RightTitle}" TextTrimming="CharacterEllipsis" />
									</Grid>

									<TextBlock Grid.Row="2"
											   Margin="16"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   Opacity="0.75"
											   Text="{Binding Comparison.Diff.Message}"
											   TextAlignment="Center"
											   TextWrapping="Wrap"
											   Visibility="{Binding Comparison.Diff.HasMessage, Converter={StaticResource BoolToVisibility}}" />

									<DataGrid x:Name="DiffGrid"
											  Grid.Row="2"
											  AutoGenerateColumns="False"
											  CanUserAddRows="False"
											  CanUserDeleteRows="False"
											  CanUserReorderColumns="False"
											  CanUserSortColumns="False"
											  FontFamily="Consolas"
											  GridLinesVisibility="None"
											  HeadersVisibility="None"
											  IsReadOnly="True"
											  ItemsSource="{Binding Comparison.Diff.Rows}"
											  RowHeight="20"
											  RowStyle="{StaticResource DiffRowStyle}"
											  SelectedItem="{Binding Comparison.Diff.SelectedRow, Mode=TwoWay}"
											  SelectionChanged="OnDiffSelectionChanged"
											  SelectionMode="Single"
											  SelectionUnit="FullRow"
											  Visibility="{Binding Comparison.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
										<DataGrid.Columns>
											<DataGridTextColumn Width="44" Binding="{Binding LeftNumberText}" ElementStyle="{StaticResource DiffNumberStyle}" />
											<DataGridTextColumn Width="*" MinWidth="100" Binding="{Binding LeftText}" />
											<DataGridTextColumn Width="44" Binding="{Binding RightNumberText}" ElementStyle="{StaticResource DiffNumberStyle}" />
											<DataGridTextColumn Width="*" MinWidth="100" Binding="{Binding RightText}" />
										</DataGrid.Columns>
									</DataGrid>
								</Grid>
						</Grid>
					</views:SplitPair.Second>
				</views:SplitPair>

				<TextBlock Grid.Row="2" Margin="0,6,0,0" Opacity="0.7" Text="{Binding Comparison.SummaryText}" TextTrimming="CharacterEllipsis" />
			</Grid>

			<StatusBar Grid.Row="3" Padding="0" FontSize="11">
				<StatusBar.ItemsPanel>
					<ItemsPanelTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
						</Grid>
					</ItemsPanelTemplate>
				</StatusBar.ItemsPanel>
				<StatusBarItem Grid.Column="0" Padding="8,2">
					<TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
				</StatusBarItem>
				<StatusBarItem Grid.Column="1" Padding="12,2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
					<TextBlock Text="{Binding FolderSummary}" />
				</StatusBarItem>
				<StatusBarItem Grid.Column="2" Padding="12,2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
					<TextBlock Text="{Binding PathText}" />
				</StatusBarItem>
				<StatusBarItem Grid.Column="3" Padding="12,2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
					<TextBlock Text="{Binding TotalText}" />
				</StatusBarItem>
			</StatusBar>

			<!-- Shown while a long operation runs: blocks the window and reports the progress. -->
			<Grid Grid.Row="0"
				  Grid.RowSpan="4"
				  Background="#99000000"
				  Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolToVisibility}}">
				<Border Width="460"
						Padding="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
						BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="8">
					<StackPanel>
						<TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Busy.Title}" />
						<ProgressBar Height="6"
									 Margin="0,16,0,8"
									 IsIndeterminate="{Binding Busy.IsIndeterminate, Mode=OneWay}"
									 Maximum="{Binding Busy.ProgressMaximum, Mode=OneWay}"
									 Value="{Binding Busy.ProgressValue, Mode=OneWay}" />
						<TextBlock Height="18"
								   Text="{Binding Busy.Detail}"
								   TextTrimming="CharacterEllipsis" />
						<Button Margin="0,16,0,0"
								MinWidth="88"
								HorizontalAlignment="Right"
								Command="{Binding Busy.CancelCommand}"
								Content="{DynamicResource Str.Cancel}"
								Visibility="{Binding Busy.CanCancel, Converter={StaticResource BoolToVisibility}}" />
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
	</Border>
</Window>