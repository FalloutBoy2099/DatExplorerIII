<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MainResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Rows of the file list: compact, with a simple selection highlight.  -->
    <Style x:Key="FileItemStyle" TargetType="ListViewItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="Row"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="DetailsItemStyle"
        BasedOn="{StaticResource FileItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="Row"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Name column: icon and text.  -->
    <!--  The warning of a message file that has problems: after its name, of the color of its worst problem.  -->
    <Style x:Key="MessageWarning" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Text" Value="&#xE7BA;" />
        <Setter Property="ToolTip" Value="{Binding MessageTip}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMessageIssues}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="#C9B458" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasMessageIssues}" Value="True" />
                    <Condition Binding="{Binding MessageSeverity}" Value="High" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="#E8A200" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasMessageIssues}" Value="True" />
                    <Condition Binding="{Binding MessageSeverity}" Value="Critical" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="#E5484D" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="NameCellTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFont}"
                FontSize="14"
                Style="{StaticResource GlyphStyle}"
                Text="{Binding Glyph}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource MessageWarning}" />
        </StackPanel>
    </DataTemplate>

    <!--  Item layouts of the "List" and "Large icons" views.  -->
    <DataTemplate x:Key="ListItemTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFont}"
                FontSize="14"
                Style="{StaticResource GlyphStyle}"
                Text="{Binding Glyph}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource MessageWarning}" />
        </StackPanel>
    </DataTemplate>

    <!--  All the icons have the same size (the panel makes only those that can be seen, and places them by that size): the name takes two lines.  -->
    <DataTemplate x:Key="IconItemTemplate">
        <StackPanel Width="84" Margin="1">
            <Grid HorizontalAlignment="Center">
                <TextBlock
                    FontFamily="{StaticResource IconFont}"
                    FontSize="28"
                    Style="{StaticResource GlyphStyle}"
                    Text="{Binding Glyph}" />
                <TextBlock
                    Margin="0,-2,-10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource MessageWarning}" />
            </Grid>
            <TextBlock
                Height="34"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Text="{Binding Name}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <GridView x:Key="DetailsView">
        <GridViewColumn
            Width="180"
            behaviors:SortColumn.Key="Name"
            CellTemplate="{StaticResource NameCellTemplate}"
            Header="{DynamicResource Str.ColName}" />
        <GridViewColumn
            Width="80"
            behaviors:SortColumn.Key="Type"
            DisplayMemberBinding="{Binding TypeText}"
            Header="{DynamicResource Str.ColType}" />
        <GridViewColumn
            Width="80"
            behaviors:SortColumn.Key="Size"
            DisplayMemberBinding="{Binding SizeText}"
            Header="{DynamicResource Str.ColSize}" />
        <GridViewColumn
            Width="130"
            behaviors:SortColumn.Key="PackedSize"
            DisplayMemberBinding="{Binding PackedSizeText}"
            Header="{DynamicResource Str.ColPacked}" />
    </GridView>

    <!--  Only the icons that can be seen are made: a folder of thousands of files shows at once.  -->
    <ItemsPanelTemplate x:Key="WrapItemsPanel">
        <views:VirtualizingWrapPanel />
    </ItemsPanelTemplate>

    <Style
        x:Key="FileListStyle"
        BasedOn="{StaticResource {x:Type ListView}}"
        TargetType="ListView">
        <Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FileItemStyle}" />
        <Style.Resources>
            <!--  The vertical scroll bar starts under the headers of the columns (in the details view), not along them.  -->
            <Style BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="ScrollBar">
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Margin" Value="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource GridViewHeaderOffset}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                <Setter Property="View" Value="{StaticResource DetailsView}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource DetailsItemStyle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                <Setter Property="ItemTemplate" Value="{StaticResource IconItemTemplate}" />
                <Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FolderItemStyle"
        BasedOn="{StaticResource {x:Type TreeViewItem}}"
        TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFont}"
                FontSize="14"
                Style="{StaticResource GlyphStyle}"
                Text="{Binding Glyph}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFont}"
                FontSize="13"
                Foreground="#E8A200"
                Text="&#xE7BA;"
                ToolTip="{DynamicResource Str.ArchiveHasProblems}"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </HierarchicalDataTemplate>

</ResourceDictionary>
