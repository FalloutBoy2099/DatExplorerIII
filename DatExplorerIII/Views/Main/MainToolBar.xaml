<UserControl
    x:Class="DatExplorerIII.Views.Main.MainToolBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="SearchBoxStyle"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchNotFound}" Value="True">
                        <Setter Property="Background" Value="#40FF5050" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="6,1"
        IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
        Visibility="{Binding Comparison.IsComparing, Converter={StaticResource InverseBoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  When the window is narrow it is the buttons that are cut, never the search.  -->
        <StackPanel
            Grid.Column="0"
            ClipToBounds="True"
            Orientation="Horizontal">
            <Button
                Command="{Binding OpenCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.OpenTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.OpenShort}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding OpenFolderCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.OpenFolder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE838;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.OpenFolderShort}" />
                </StackPanel>
            </Button>
            <Separator Margin="2,4" />
            <Button
                Command="{Binding NewFallout2Command, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.NewFallout2}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort2}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding NewFallout1Command, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.NewFallout1}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShort1}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding NewArcanumCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.NewArcanum}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewShortArcanum}" />
                </StackPanel>
            </Button>
            <Separator Margin="2,4" />
            <Button
                Command="{Binding SaveCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.SaveTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Save}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding QuickSaveCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.QuickSaveTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE945;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.QuickSaveShort}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding CloseDatCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.CloseDatTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.CloseShort}" />
                </StackPanel>
            </Button>
            <Separator Margin="2,4" />
            <Button
                Command="{Binding UpCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.UpTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74A;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.Up}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding ExtractItemsCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.ExtractFilesTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE896;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ExtractShort}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding ImportFilesCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.ImportFilesTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE898;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.ImportShort}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding NewFolderCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{DynamicResource Str.NewFolder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8F4;" />
                    <TextBlock Style="{StaticResource ToolLabel}" Text="{DynamicResource Str.NewFolderShort}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBox
                x:Name="SearchBox"
                Width="160"
                Height="24"
                VerticalContentAlignment="Center"
                behaviors:FocusBehavior.Trigger="{Binding SearchFocusRequests}"
                Style="{StaticResource SearchBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{DynamicResource Str.SearchTip}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding FindNextCommand}" />
                    <KeyBinding
                        Key="Return"
                        Command="{Binding FindPreviousCommand}"
                        Modifiers="Shift" />
                </TextBox.InputBindings>
            </TextBox>
            <Button
                Height="24"
                Margin="4,0,0,0"
                Padding="8,0"
                Command="{Binding GlobalSearchCommand, Mode=OneTime}"
                ToolTip="{DynamicResource Str.SearchAll}">
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource ToolIcon}"
                    Text="&#xE721;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
