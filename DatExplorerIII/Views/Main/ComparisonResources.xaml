<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MainResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  The text of a cell of the list of the compared files: in the middle of the line, like the icon of the state.  -->
    <Style x:Key="CellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  A cell of the list of the compared files: a short line, with its content in the middle (the theme gives the cells room that a list of thousands of files cannot afford).  -->
    <Style
        x:Key="ComparisonCellStyle"
        BasedOn="{StaticResource {x:Type DataGridCell}}"
        TargetType="DataGridCell">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  The numbers of the lines of the differences: small, at the right of their place.  -->
    <Style x:Key="DiffNumberStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--  The line of a text: what changed, what only one text has.  -->
    <Style
        x:Key="DiffRowStyle"
        BasedOn="{StaticResource {x:Type DataGridRow}}"
        TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Changed">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Ignored">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  The tree of the folders of a comparison.  -->
    <Style
        x:Key="ComparisonFolderItemStyle"
        BasedOn="{StaticResource {x:Type TreeViewItem}}"
        TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <HierarchicalDataTemplate x:Key="ComparisonFolderTemplate" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFont}"
                Foreground="{StaticResource FolderBrush}"
                Text="&#xF12B;" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{Binding CountText}" />
        </StackPanel>
    </HierarchicalDataTemplate>

</ResourceDictionary>
