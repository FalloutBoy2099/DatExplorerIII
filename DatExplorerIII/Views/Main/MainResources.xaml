<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <infrastructure:InverseBooleanConverter x:Key="InverseBool" />

    <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <infrastructure:BooleanToOrientationConverter x:Key="BoolToOrientation" />

    <infrastructure:GridViewHeaderOffsetConverter x:Key="GridViewHeaderOffset" />

    <SolidColorBrush x:Key="FolderBrush" Color="#FFC83D" />

    <SolidColorBrush
        x:Key="SelectedRowBrush"
        Opacity="0.45"
        Color="{x:Static SystemColors.AccentColor}" />

    <SolidColorBrush
        x:Key="HoverRowBrush"
        Opacity="0.18"
        Color="{x:Static SystemColors.AccentColor}" />

    <!--  Icon of a folder or a file: folders are yellow.  -->
    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                <Setter Property="Foreground" Value="#E5534B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
