<UserControl
    x:Class="DatExplorerIII.Views.Main.MainStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <StatusBar Padding="0" FontSize="11">
        <StatusBar.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ItemsPanelTemplate>
        </StatusBar.ItemsPanel>
        <StatusBarItem Grid.Column="0" Padding="8,2">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </StatusBarItem>
        <StatusBarItem
            Grid.Column="1"
            Padding="12,2"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <TextBlock Text="{Binding FolderSummary}" />
        </StatusBarItem>
        <StatusBarItem
            Grid.Column="2"
            Padding="12,2"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <TextBlock Text="{Binding PathText}" />
        </StatusBarItem>
        <StatusBarItem
            Grid.Column="3"
            Padding="12,2"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <TextBlock Text="{Binding TotalText}" />
        </StatusBarItem>
    </StatusBar>
</UserControl>
