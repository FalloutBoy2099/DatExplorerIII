<UserControl
    x:Class="DatExplorerIII.Views.Main.ComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="clr-namespace:DatExplorerIII.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComparisonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="6,0,6,6"
        IsEnabled="{Binding Busy.IsBusy, Converter={StaticResource InverseBool}}"
        Visibility="{Binding Comparison.IsComparing, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The tool bar: only icons, the text is the tool tip.  -->
        <StackPanel Margin="0,-6,0,12" Orientation="Horizontal">
            <ToggleButton
                AutomationProperties.Name="{Binding Comparison.Current.DifferentFilterText}"
                IsChecked="{Binding Comparison.Current.ShowDifferent}"
                Style="{StaticResource IconToggle}"
                ToolTip="{Binding Comparison.Current.DifferentFilterText}">
                <TextBlock
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Style="{StaticResource ToolIcon}"
                    Text="&#xE7BA;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{Binding Comparison.Current.LeftOnlyFilterText}"
                IsChecked="{Binding Comparison.Current.ShowLeftOnly}"
                Style="{StaticResource IconToggle}"
                ToolTip="{Binding Comparison.Current.LeftOnlyFilterText}">
                <TextBlock
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource ToolIcon}"
                    Text="&#xE72B;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{Binding Comparison.Current.RightOnlyFilterText}"
                IsChecked="{Binding Comparison.Current.ShowRightOnly}"
                Style="{StaticResource IconToggle}"
                ToolTip="{Binding Comparison.Current.RightOnlyFilterText}">
                <TextBlock
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Style="{StaticResource ToolIcon}"
                    Text="&#xE72A;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{Binding Comparison.Current.IdenticalFilterText}"
                IsChecked="{Binding Comparison.Current.ShowIdentical}"
                Style="{StaticResource IconToggle}"
                ToolTip="{Binding Comparison.Current.IdenticalFilterText}">
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource ToolIcon}"
                    Text="&#xE73E;" />
            </ToggleButton>

            <Rectangle
                Width="1"
                Margin="8,6"
                Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="0.5" />

            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareSubfolders}"
                IsChecked="{Binding Comparison.Current.IncludeSubfolders}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareSubfolders}">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE81E;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareTree}"
                IsChecked="{Binding Comparison.IsCompareTreeVisible}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareTree}">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A0;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareShowDifferences}"
                IsChecked="{Binding Comparison.Current.ShowDifferences}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareShowDifferences}">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE746;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareLayoutListStacked}"
                IsChecked="{Binding Comparison.IsCompareListStacked}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareLayoutListStacked}">
                <Path Style="{StaticResource LayoutIconList}" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareLayoutViewersStacked}"
                IsChecked="{Binding Comparison.IsCompareViewersStacked}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareLayoutViewersStacked}">
                <Path Style="{StaticResource LayoutIconViewers}" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{DynamicResource Str.CompareLayoutGroupsStacked}"
                IsChecked="{Binding Comparison.IsCompareGroupsStacked}"
                Style="{StaticResource IconToggle}"
                ToolTip="{DynamicResource Str.CompareLayoutGroupsStacked}">
                <Path Style="{StaticResource LayoutIconGroups}" />
            </ToggleButton>

            <Rectangle
                Width="1"
                Margin="8,6"
                Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="0.5" />

            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareCopyLeft}"
                Command="{Binding Comparison.CopyToLeftCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareCopyLeft}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Text="&#xE72B;" />
                    <TextBlock
                        Margin="2,0,0,0"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE8C8;" />
                </StackPanel>
            </Button>
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareCopyRight}"
                Command="{Binding Comparison.CopyToRightCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareCopyRight}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE8C8;" />
                    <TextBlock
                        Margin="2,0,0,0"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Text="&#xE72A;" />
                </StackPanel>
            </Button>
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareMoveLeft}"
                Command="{Binding Comparison.MoveToLeftCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareMoveLeft}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Text="&#xE72B;" />
                    <TextBlock
                        Margin="2,0,0,0"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE8C6;" />
                </StackPanel>
            </Button>
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareMoveRight}"
                Command="{Binding Comparison.MoveToRightCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareMoveRight}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE8C6;" />
                    <TextBlock
                        Margin="2,0,0,0"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Text="&#xE72A;" />
                </StackPanel>
            </Button>

            <Rectangle
                Width="1"
                Margin="8,6"
                Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="0.5" />

            <!--  The bar at the side of the disk tells which archive is saved.  -->
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareSaveLeft}"
                Command="{Binding Comparison.SaveLeftCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareSaveLeft}">
                <Border
                    Padding="5,0,0,0"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="3,0,0,0">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                </Border>
            </Button>
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareSaveRight}"
                Command="{Binding Comparison.SaveRightCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareSaveRight}">
                <Border
                    Padding="0,0,5,0"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="0,0,3,0">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                </Border>
            </Button>

            <Rectangle
                Width="1"
                Margin="8,6"
                Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="0.5" />

            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareAgain}"
                Command="{Binding Comparison.CompareAgainCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareAgain}">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72C;" />
            </Button>
            <Button
                AutomationProperties.Name="{DynamicResource Str.CompareClose}"
                Command="{Binding Comparison.CloseComparisonCommand, Mode=OneTime}"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Str.CompareClose}">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE711;" />
            </Button>
        </StackPanel>

        <!--  Folders and files, then the two archives: each pair side by side or one above the other, and the two pairs too.  -->
        <views:SplitPair
            Grid.Row="1"
            FirstWeight="1.3"
            Orientation="{Binding Comparison.IsCompareGroupsStacked, Converter={StaticResource BoolToOrientation}}"
            SecondWeight="1">
            <views:SplitPair.First>
                <views:SplitPair
                    FirstVisible="{Binding Comparison.IsCompareTreeVisible}"
                    FirstWeight="1"
                    Orientation="{Binding Comparison.IsCompareListStacked, Converter={StaticResource BoolToOrientation}}"
                    SecondWeight="2.4">
                    <views:SplitPair.First>
                        <TreeView
                            ItemContainerStyle="{StaticResource ComparisonFolderItemStyle}"
                            ItemTemplate="{StaticResource ComparisonFolderTemplate}"
                            ItemsSource="{Binding Comparison.Current.Tree}" />
                    </views:SplitPair.First>
                    <views:SplitPair.Second>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ComboBox
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{DynamicResource Str.CompareFolderTip}"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Comparison.Current.FlatFolders}"
                                SelectedItem="{Binding Comparison.Current.SelectedFolder}"
                                ToolTip="{DynamicResource Str.CompareFolderTip}" />

                            <DataGrid
                                x:Name="ComparisonGrid"
                                Grid.Row="1"
                                behaviors:SelectionBehavior.Command="{Binding Comparison.Current.SelectRowsCommand}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CellStyle="{StaticResource ComparisonCellStyle}"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding Comparison.Current.Rows}"
                                RowHeight="20"
                                SelectionMode="Extended"
                                SelectionUnit="FullRow">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding Comparison.CopyToLeftCommand}" Header="{DynamicResource Str.CompareCopyLeft}" />
                                        <MenuItem Command="{Binding Comparison.CopyToRightCommand}" Header="{DynamicResource Str.CompareCopyRight}" />
                                        <Separator />
                                        <MenuItem Command="{Binding Comparison.MoveToLeftCommand}" Header="{DynamicResource Str.CompareMoveLeft}" />
                                        <MenuItem Command="{Binding Comparison.MoveToRightCommand}" Header="{DynamicResource Str.CompareMoveRight}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="150" Header="{DynamicResource Str.CompareStatus}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="20"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource IconFont}"
                                                        FontSize="12"
                                                        LineHeight="14"
                                                        LineStackingStrategy="BlockLineHeight"
                                                        Text="{Binding Glyph}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding StateText}" />
                                                    <StackPanel.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Identical">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Different">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="LeftOnly">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="RightOnly">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="160"
                                        Binding="{Binding Path}"
                                        ElementStyle="{StaticResource CellTextStyle}"
                                        Header="{DynamicResource Str.ComparePath}" />
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding LeftSizeText}"
                                        ElementStyle="{StaticResource CellTextStyle}"
                                        Header="{DynamicResource Str.CompareLeftSize}" />
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding RightSizeText}"
                                        ElementStyle="{StaticResource CellTextStyle}"
                                        Header="{DynamicResource Str.CompareRightSize}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </views:SplitPair.Second>
                </views:SplitPair>
            </views:SplitPair.First>

            <views:SplitPair.Second>
                <Grid>
                    <Grid Visibility="{Binding Comparison.Current.ShowDifferences, Converter={StaticResource InverseBoolToVisibility}}">
                        <views:SplitPair Orientation="{Binding Comparison.IsCompareViewersStacked, Converter={StaticResource BoolToOrientation}}">
                            <views:SplitPair.First>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Margin="8,0,0,4"
                                        FontWeight="SemiBold"
                                        Text="{Binding Comparison.Current.LeftTitle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Comparison.Current.LeftToolTip}" />
                                    <Border
                                        x:Name="LeftViewerHost"
                                        Grid.Row="1"
                                        Padding="8,0,0,0"
                                        behaviors:ScrollSync.IsEnabled="{Binding IsCompareSyncScroll}"
                                        behaviors:ScrollSync.Partner="{Binding ElementName=RightViewerHost}">
                                        <views:ViewerControl DataContext="{Binding Comparison.Current.LeftViewer}" />
                                    </Border>
                                </Grid>
                            </views:SplitPair.First>
                            <views:SplitPair.Second>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Margin="8,0,0,4"
                                        FontWeight="SemiBold"
                                        Text="{Binding Comparison.Current.RightTitle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Comparison.Current.RightToolTip}" />
                                    <Border
                                        x:Name="RightViewerHost"
                                        Grid.Row="1"
                                        Padding="8,0,0,0"
                                        behaviors:ScrollSync.IsEnabled="{Binding IsCompareSyncScroll}"
                                        behaviors:ScrollSync.Partner="{Binding ElementName=LeftViewerHost}">
                                        <views:ViewerControl DataContext="{Binding Comparison.Current.RightViewer}" />
                                    </Border>
                                </Grid>
                            </views:SplitPair.Second>
                        </views:SplitPair>
                    </Grid>
                    <Grid Visibility="{Binding Comparison.Current.ShowDifferences, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="4,0,0,4" Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="{DynamicResource Str.CompareDiffPrevious}"
                                Command="{Binding Comparison.Current.Diff.PreviousCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{DynamicResource Str.CompareDiffPrevious}">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70E;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{DynamicResource Str.CompareDiffNext}"
                                Command="{Binding Comparison.Current.Diff.NextCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{DynamicResource Str.CompareDiffNext}">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE70D;" />
                            </Button>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Comparison.Current.Diff.Summary}" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Margin="4,0,17,2"
                            Visibility="{Binding Comparison.Current.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="{Binding Comparison.Current.LeftTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                FontWeight="SemiBold"
                                Text="{Binding Comparison.Current.RightTitle}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.75"
                            Text="{Binding Comparison.Current.Diff.Message}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding Comparison.Current.Diff.HasMessage, Converter={StaticResource BoolToVisibility}}" />

                        <DataGrid
                            x:Name="DiffGrid"
                            Grid.Row="2"
                            behaviors:ScrollIntoViewBehavior.Enabled="True"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            FontFamily="Consolas"
                            GridLinesVisibility="None"
                            HeadersVisibility="None"
                            IsReadOnly="True"
                            ItemsSource="{Binding Comparison.Current.Diff.Rows}"
                            RowHeight="20"
                            RowStyle="{StaticResource DiffRowStyle}"
                            SelectedItem="{Binding Comparison.Current.Diff.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            Visibility="{Binding Comparison.Current.Diff.HasRows, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="44"
                                    Binding="{Binding LeftNumberText}"
                                    ElementStyle="{StaticResource DiffNumberStyle}" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="100"
                                    Binding="{Binding LeftText}" />
                                <DataGridTextColumn
                                    Width="44"
                                    Binding="{Binding RightNumberText}"
                                    ElementStyle="{StaticResource DiffNumberStyle}" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="100"
                                    Binding="{Binding RightText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </views:SplitPair.Second>
        </views:SplitPair>

        <TextBlock
            Grid.Row="2"
            Margin="0,6,0,0"
            Opacity="0.7"
            Text="{Binding Comparison.Current.SummaryText}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
