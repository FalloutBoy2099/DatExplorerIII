<UserControl
    x:Class="DatExplorerIII.Views.Viewer.VideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:viewer="clr-namespace:DatExplorerIII.Views.Viewer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <Button Padding="16,6" Command="{Binding PlayStopCommand, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE769;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Str.ViewerPlay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Str.ViewerPause}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Notice}"
                Text="{Binding Warning}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="Black"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Image
                        behaviors:PixelImageSource.Image="{Binding Frame}"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        SnapsToDevicePixels="True" />
                </Viewbox>

                <!--  The subtitle of the picture (the .sve file of the movie), at the bottom of the picture.  -->
                <Border
                    Margin="24,0,24,16"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#B0000000"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="16"
                        Foreground="White"
                        Text="{Binding Subtitle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider
                IsMoveToPointEnabled="True"
                IsSnapToTickEnabled="True"
                LargeChange="30"
                Maximum="{Binding LastFrame}"
                Minimum="0"
                SmallChange="1"
                Thumb.DragCompleted="OnSeekCompleted"
                Thumb.DragStarted="OnSeekStarted"
                TickFrequency="1"
                Value="{Binding Position, Delay=30}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Opacity="0.8"
                Text="{Binding PositionText}" />
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,6,0,0"
            Opacity="0.7"
            Text="{Binding Info}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
