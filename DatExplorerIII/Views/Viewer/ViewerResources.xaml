<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    xmlns:viewer="clr-namespace:DatExplorerIII.Views.Viewer">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!--  The odd lines of a table are a little different from the even ones: a faint gray that shows on a light and on a dark theme (the theme brush is too close to the background).  -->
    <SolidColorBrush x:Key="StripeBrush" Color="#26808080" />

    <!--  The label of a check box of a tool bar, centered on its box (the theme draws it about two pixels low).  -->
    <Style
        x:Key="ToolbarCheckBox"
        BasedOn="{StaticResource {x:Type CheckBox}}"
        TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0,0,3" />
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#E8A200" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The two labels of the button that plays and pauses are both in the button, one over the other, and only one shows: the button
        has the width of the longer one, whatever the language, and does not change its size when it is pressed.
    -->
    <Style x:Key="ShownWhenStopped" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShownWhenPlaying" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
