<Window
    x:Class="DatExplorerIII.Views.Viewer.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewer="clr-namespace:DatExplorerIII.Views.Viewer"
    Title="{Binding Title}"
    Width="780"
    Height="600"
    MinWidth="420"
    MinHeight="300"
    FontSize="12"
    Icon="pack://application:,,,/Resources/app.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner">

    <viewer:ViewerControl Margin="12" />

</Window>