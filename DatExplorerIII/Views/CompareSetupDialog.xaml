<Window x:Class="DatExplorerIII.Views.CompareSetupDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="DatExplorerIII"
		Width="680"
		SizeToContent="Height"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner"
		FontSize="12">

	<Window.Resources>
		<FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

		<!-- A button with an icon and its text. -->
		<Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Margin" Value="8,0,0,0" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="MinWidth" Value="104" />
		</Style>

		<!-- One side: its name with a bar on the side it is on, the box (with the archives that are known), the buttons, what it is. -->
		<Style x:Key="SideGroup" TargetType="Border">
			<Setter Property="Padding" Value="14,10,14,10" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="AllowDrop" Value="True" />
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Margin="20,18,20,12">
			<TextBlock Text="{DynamicResource Str.CompareHint}" TextWrapping="Wrap" />
			<TextBlock Margin="0,2,0,12" Opacity="0.65" Text="{DynamicResource Str.CompareDropHint}" TextWrapping="Wrap" />

			<Border x:Name="LeftGroup"
					Style="{StaticResource SideGroup}"
					BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
					BorderThickness="4,1,1,1"
					PreviewDragOver="OnPreviewDragOver"
					Drop="OnDropLeft">
				<StackPanel>
					<TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{DynamicResource Str.CompareLeft}" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ComboBox x:Name="LeftBox" IsEditable="True" HorizontalAlignment="Stretch" />
						<Button Grid.Column="1" Style="{StaticResource BrowseButton}" Click="OnLeftFile" ToolTip="{DynamicResource Str.CompareChooseFile}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" />
								<TextBlock Text="{DynamicResource Str.CompareFile}" />
							</StackPanel>
						</Button>
						<Button Grid.Column="2" Style="{StaticResource BrowseButton}" Click="OnLeftFolder" ToolTip="{DynamicResource Str.CompareChooseFolder}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xF12B;" />
								<TextBlock Text="{DynamicResource Str.CompareFolder}" />
							</StackPanel>
						</Button>
					</Grid>
					<TextBlock x:Name="LeftInfo" Margin="0,6,0,0" MinHeight="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</Border>

			<Button HorizontalAlignment="Center"
					Margin="0,4"
					Padding="14,3"
					Click="OnSwap"
					ToolTip="{DynamicResource Str.CompareSwap}"
					AutomationProperties.Name="{DynamicResource Str.CompareSwap}">
				<TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8CB;" />
			</Button>

			<Border x:Name="RightGroup"
					Style="{StaticResource SideGroup}"
					BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
					BorderThickness="1,1,4,1"
					PreviewDragOver="OnPreviewDragOver"
					Drop="OnDropRight">
				<StackPanel>
					<TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{DynamicResource Str.CompareRight}" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ComboBox x:Name="RightBox" IsEditable="True" HorizontalAlignment="Stretch" />
						<Button Grid.Column="1" Style="{StaticResource BrowseButton}" Click="OnRightFile" ToolTip="{DynamicResource Str.CompareChooseFile}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" />
								<TextBlock Text="{DynamicResource Str.CompareFile}" />
							</StackPanel>
						</Button>
						<Button Grid.Column="2" Style="{StaticResource BrowseButton}" Click="OnRightFolder" ToolTip="{DynamicResource Str.CompareChooseFolder}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xF12B;" />
								<TextBlock Text="{DynamicResource Str.CompareFolder}" />
							</StackPanel>
						</Button>
					</Grid>
					<TextBlock x:Name="RightInfo" Margin="0,6,0,0" MinHeight="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</Border>

			<TextBlock x:Name="ErrorText"
					   Margin="0,10,0,0"
					   MinHeight="20"
					   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
					   TextWrapping="Wrap" />
		</StackPanel>

		<Border Grid.Row="1"
				Padding="20,12"
				Background="{DynamicResource LayerFillColorDefaultBrush}">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button x:Name="OkButton"
						MinWidth="110"
						Content="{DynamicResource Str.CompareStart}"
						IsDefault="True"
						IsEnabled="False"
						Click="OnOk" />
				<Button MinWidth="88"
						Margin="8,0,0,0"
						Content="{DynamicResource Str.Cancel}"
						IsCancel="True" />
			</StackPanel>
		</Border>
	</Grid>

</Window>