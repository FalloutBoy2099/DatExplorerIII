<Window
    x:Class="DatExplorerIII.Views.CompareSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DatExplorerIII"
    Width="680"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!--  A button with an icon and its text.  -->
        <Style
            x:Key="BrowseButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="104" />
        </Style>

        <!--  One side: its name with a bar on the side it is on, the box (with the archives that are known), the buttons, what it is.  -->
        <Style x:Key="SideGroup" TargetType="Border">
            <Setter Property="Padding" Value="14,10,14,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,18,20,12">
            <TextBlock Text="{DynamicResource Str.CompareHint}" TextWrapping="Wrap" />
            <TextBlock
                Margin="0,2,0,12"
                Opacity="0.65"
                Text="{DynamicResource Str.CompareDropHint}"
                TextWrapping="Wrap" />

            <Border
                x:Name="LeftGroup"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="4,1,1,1"
                Drop="OnDropLeft"
                PreviewDragOver="OnPreviewDragOver"
                Style="{StaticResource SideGroup}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Str.CompareLeft}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="LeftBox"
                            HorizontalAlignment="Stretch"
                            IsEditable="True" />
                        <Button
                            Grid.Column="1"
                            Click="OnLeftFile"
                            Style="{StaticResource BrowseButton}"
                            ToolTip="{DynamicResource Str.CompareChooseFile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    Text="&#xE8E5;" />
                                <TextBlock Text="{DynamicResource Str.CompareFile}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="OnLeftFolder"
                            Style="{StaticResource BrowseButton}"
                            ToolTip="{DynamicResource Str.CompareChooseFolder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    Text="&#xF12B;" />
                                <TextBlock Text="{DynamicResource Str.CompareFolder}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="LeftInfo"
                        MinHeight="16"
                        Margin="0,6,0,0"
                        Opacity="0.7"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Button
                Margin="0,4"
                Padding="14,3"
                HorizontalAlignment="Center"
                AutomationProperties.Name="{DynamicResource Str.CompareSwap}"
                Click="OnSwap"
                ToolTip="{DynamicResource Str.CompareSwap}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8CB;" />
            </Button>

            <Border
                x:Name="RightGroup"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1,1,4,1"
                Drop="OnDropRight"
                PreviewDragOver="OnPreviewDragOver"
                Style="{StaticResource SideGroup}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Str.CompareRight}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="RightBox"
                            HorizontalAlignment="Stretch"
                            IsEditable="True" />
                        <Button
                            Grid.Column="1"
                            Click="OnRightFile"
                            Style="{StaticResource BrowseButton}"
                            ToolTip="{DynamicResource Str.CompareChooseFile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    Text="&#xE8E5;" />
                                <TextBlock Text="{DynamicResource Str.CompareFile}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="OnRightFolder"
                            Style="{StaticResource BrowseButton}"
                            ToolTip="{DynamicResource Str.CompareChooseFolder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    Text="&#xF12B;" />
                                <TextBlock Text="{DynamicResource Str.CompareFolder}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="RightInfo"
                        MinHeight="16"
                        Margin="0,6,0,0"
                        Opacity="0.7"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="ErrorText"
                MinHeight="20"
                Margin="0,10,0,0"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    MinWidth="110"
                    Click="OnOk"
                    Content="{DynamicResource Str.CompareStart}"
                    IsDefault="True"
                    IsEnabled="False" />
                <Button
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Content="{DynamicResource Str.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>

</Window>