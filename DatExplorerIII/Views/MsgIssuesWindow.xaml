<Window
    x:Class="DatExplorerIII.Views.MsgIssuesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Str.MsgIssuesTitle}"
    Width="980"
    Height="560"
    MinWidth="640"
    MinHeight="380"
    FontSize="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--
            A severity that can be shown or hidden: a flat button that is lit (accent border, filled) when the problems of that
            severity are shown, and dimmed when they are hidden.
        -->
        <Style x:Key="SeverityToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="0.6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeverityGlyph" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="&#xE7BA;" />
        </Style>

        <!--  The mark of a file of the list: the color of its worst problem.  -->
        <Style
            x:Key="FileMark"
            BasedOn="{StaticResource SeverityGlyph}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Worst}" Value="Critical">
                    <Setter Property="Foreground" Value="#E5484D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Worst}" Value="High">
                    <Setter Property="Foreground" Value="#E8A200" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Worst}" Value="Medium">
                    <Setter Property="Foreground" Value="#C9B458" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The mark of the problem that is shown.  -->
        <Style
            x:Key="CurrentMark"
            BasedOn="{StaticResource SeverityGlyph}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="#E5484D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentSeverity}" Value="High">
                    <Setter Property="Foreground" Value="#E8A200" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentSeverity}" Value="Medium">
                    <Setter Property="Foreground" Value="#C9B458" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  A button of the stepper or a copy button: one icon.  -->
        <Style
            x:Key="IconButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!--  A short line, as in the explorer: the item is as wide as the list, and not taller than its text.  -->
        <Style
            x:Key="FileItem"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  The text of an error or of a line: to read, select and copy.  -->
        <Style
            x:Key="ReadOnlyText"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <ToggleButton
                x:Name="CriticalBox"
                IsChecked="{Binding ShowCritical}"
                Style="{StaticResource SeverityToggle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#E5484D" Style="{StaticResource SeverityGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding CriticalText}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                x:Name="HighBox"
                IsChecked="{Binding ShowHigh}"
                Style="{StaticResource SeverityToggle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#E8A200" Style="{StaticResource SeverityGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding HighText}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                x:Name="MediumBox"
                IsChecked="{Binding ShowMedium}"
                Style="{StaticResource SeverityToggle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#C9B458" Style="{StaticResource SeverityGlyph}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding MediumText}" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  The files that have problems.  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="2,0,0,6"
                    Style="{StaticResource SectionTitle}"
                    Text="{DynamicResource Str.MsgFiles}" />
                <ListBox
                    x:Name="FilesList"
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource FileItem}"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,20,0" ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FileMark}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Count}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!--  The problems of the selected file, one at a time.  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Button
                        x:Name="FirstButton"
                        AutomationProperties.Name="{DynamicResource Str.MsgFirst}"
                        Command="{Binding FirstCommand, Mode=OneTime}"
                        Content="&#xE892;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource Str.MsgFirst}" />
                    <Button
                        x:Name="PreviousButton"
                        AutomationProperties.Name="{DynamicResource Str.MsgPrevious}"
                        Command="{Binding PreviousCommand, Mode=OneTime}"
                        Content="&#xE76B;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource Str.MsgPrevious}" />
                    <TextBlock
                        x:Name="PositionLabel"
                        MinWidth="64"
                        Margin="4,0,8,0"
                        VerticalAlignment="Center"
                        Text="{Binding PositionText}"
                        TextAlignment="Center" />
                    <Button
                        x:Name="NextButton"
                        AutomationProperties.Name="{DynamicResource Str.MsgNext}"
                        Command="{Binding NextCommand, Mode=OneTime}"
                        Content="&#xE76C;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource Str.MsgNext}" />
                    <Button
                        x:Name="LastButton"
                        AutomationProperties.Name="{DynamicResource Str.MsgLast}"
                        Command="{Binding LastCommand, Mode=OneTime}"
                        Content="&#xE893;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource Str.MsgLast}" />
                    <Rectangle Width="12" />
                    <TextBlock Style="{StaticResource CurrentMark}" />
                    <TextBlock
                        x:Name="SeverityLabel"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentSeverityText}" />
                    <TextBlock
                        x:Name="LocationLabel"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CurrentLocation}" />
                </StackPanel>

                <!--  The error, in words.  -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <Button
                            x:Name="CopyMessageButton"
                            Margin="0"
                            AutomationProperties.Name="{DynamicResource Str.MsgCopyText}"
                            Command="{Binding CopyMessageCommand, Mode=OneTime}"
                            Content="&#xE8C8;"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Str.MsgCopyText}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Str.MsgError}" />
                    </DockPanel>
                    <TextBox
                        x:Name="MessageBox"
                        Grid.Row="1"
                        Style="{StaticResource ReadOnlyText}"
                        Text="{Binding CurrentMessage, Mode=OneWay}" />
                </Grid>

                <!--  The line of the file, as it is written.  -->
                <DockPanel
                    Grid.Row="2"
                    Margin="0,10,0,4"
                    LastChildFill="False">
                    <Button
                        x:Name="CopyValueButton"
                        Margin="0"
                        AutomationProperties.Name="{DynamicResource Str.MsgCopyText}"
                        Command="{Binding CopyValueCommand, Mode=OneTime}"
                        Content="&#xE8C8;"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource Str.MsgCopyText}" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Str.MsgValue}" />
                </DockPanel>
                <TextBox
                    x:Name="ValueBox"
                    Grid.Row="3"
                    FontFamily="Consolas, Courier New"
                    Style="{StaticResource ReadOnlyText}"
                    Text="{Binding CurrentValue, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  How many problems there are, at the bottom right.  -->
        <TextBlock
            x:Name="SummaryText"
            Grid.Row="2"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Summary}" />
    </Grid>

</Window>
