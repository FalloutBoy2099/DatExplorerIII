<Window x:Class="DatExplorerIII.Views.InputDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="DatExplorerIII"
		Width="440"
		SizeToContent="Height"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner"
		FontSize="12">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Margin="20,20,20,16">
			<TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
			<TextBox x:Name="ValueBox" TextChanged="OnValueChanged" />
			<TextBlock x:Name="ErrorText"
					   Margin="0,8,0,0"
					   MinHeight="20"
					   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
					   TextWrapping="Wrap" />
		</StackPanel>

		<Border Grid.Row="1"
				Padding="20,12"
				Background="{DynamicResource LayerFillColorDefaultBrush}">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button x:Name="OkButton"
						MinWidth="88"
						Content="{DynamicResource Str.Ok}"
						IsDefault="True"
						Click="OnOk" />
				<Button MinWidth="88"
						Margin="8,0,0,0"
						Content="{DynamicResource Str.Cancel}"
						IsCancel="True" />
			</StackPanel>
		</Border>
	</Grid>
</Window>