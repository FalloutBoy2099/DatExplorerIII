<UserControl
    x:Class="DatExplorerIII.Views.ViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DatExplorerIII.Views.Behaviors"
    xmlns:infrastructure="clr-namespace:DatExplorerIII.Infrastructure"
    FontSize="12">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infrastructure:EnvelopeGeometryConverter x:Key="EnvelopeGeometry" />
        <infrastructure:FractionOfWidthConverter x:Key="FractionOfWidth" />
        <infrastructure:RightMarginConverter x:Key="RightMargin" />
        <infrastructure:ScrollBarPaddingConverter x:Key="ScrollBarPadding" />
        <infrastructure:EndingTextMarginConverter x:Key="EndingTextMargin" />

        <!--  The grid that shows through the transparent parts of a sprite  -->
        <DrawingBrush
            x:Key="CheckerBrush"
            TileMode="Tile"
            Viewbox="0,0,16,16"
            ViewboxUnits="Absolute"
            Viewport="0,0,16,16"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#26808080">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#26FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  The odd lines of a table are a little lighter than the even ones.  -->
        <Style
            x:Key="StripedRow"
            BasedOn="{StaticResource {x:Type DataGridRow}}"
            TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  A group of lines of a sheet (a character, a prototype)  -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,12,14">
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="{Binding Title}" />
                <ItemsControl AlternationCount="2" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        FontWeight="SemiBold"
                                        Text="{Binding Value}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!--  The text of a cell of a table can go on several lines  -->
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="4,3" />
        </Style>

        <!--  The label of a check box of a tool bar, centered on its box (the theme draws it about two pixels low).  -->
        <Style
            x:Key="ToolbarCheckBox"
            BasedOn="{StaticResource {x:Type CheckBox}}"
            TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0,0,3" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#E8A200" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  Nothing to show: no file, a file that cannot be shown, an error  -->
        <TextBlock
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.7"
            Text="{Binding Message}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.7"
            Text="{DynamicResource Str.ViewerLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!--  Text  -->
        <Grid DataContext="{Binding Text}" Visibility="{Binding DataContext.IsText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  A narrow pane puts what does not fit on the next line.  -->
            <WrapPanel Margin="0,0,0,2">
                <StackPanel
                    Margin="0,0,0,4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolbarLabel}" Text="{DynamicResource Str.ViewerEncoding}" />
                    <ComboBox
                        MinWidth="190"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedEncoding}" />
                </StackPanel>
                <CheckBox
                    Margin="14,0,0,4"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Str.ViewerWrap}"
                    IsChecked="{Binding WrapLines}"
                    Style="{StaticResource ToolbarCheckBox}" />
                <Button
                    Margin="8,0,0,4"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.ViewerCopy}"
                    Command="{Binding CopyCommand, Mode=OneTime}"
                    ToolTip="{DynamicResource Str.ViewerCopy}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="MessageProblemsButton"
                    Margin="4,0,0,4"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.MsgProblemsCommand}"
                    Command="{Binding ShowProblemsCommand, Mode=OneTime}"
                    ToolTip="{DynamicResource Str.MsgProblemsCommand}"
                    Visibility="{Binding CanShowProblems, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" />
                </Button>
            </WrapPanel>

            <TextBox
                Grid.Row="1"
                AcceptsReturn="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="True"
                Text="{Binding Text, Mode=OneWay}"
                VerticalScrollBarVisibility="Auto">
                <TextBox.Style>
                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                        <Setter Property="TextWrapping" Value="NoWrap" />
                        <!--  The scroll bars are drawn over the text: the padding leaves them room (the horizontal one only when the lines do not wrap).  -->
                        <Setter Property="Padding" Value="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource ScrollBarPadding}, ConverterParameter='10,5,6,6|rb'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WrapLines}" Value="True">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Padding" Value="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource ScrollBarPadding}, ConverterParameter='10,5,6,6|r'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--  A text with colors (message files): the document is made by the code behind.  -->
            <RichTextBox
                x:Name="HighlightedBox"
                Grid.Row="1"
                FontFamily="Consolas"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="True"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVisibility}}">
                <RichTextBox.Style>
                    <Style BasedOn="{StaticResource {x:Type RichTextBox}}" TargetType="RichTextBox">
                        <Setter Property="Padding" Value="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource ScrollBarPadding}, ConverterParameter='10,5,6,6|rb'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WrapLines}" Value="True">
                                <Setter Property="Padding" Value="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource ScrollBarPadding}, ConverterParameter='10,5,6,6|r'}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Style>
            </RichTextBox>

            <!--  The state of the text on the left, and what is wrong with it (a binary file, a message file with problems...) on the right.  -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Opacity="0.7"
                    Text="{Binding Status}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource Notice}"
                    Text="{Binding Notice}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding NoticeTip}" />
            </Grid>
        </Grid>

        <!--  Picture  -->
        <Grid DataContext="{Binding Image}" Visibility="{Binding DataContext.IsImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel
                        Margin="0,0,14,4"
                        Orientation="Horizontal"
                        Visibility="{Binding HasPaletteChoices, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="{DynamicResource Str.ViewerPalette}" />
                        <ComboBox
                            MinWidth="150"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding PaletteChoices}"
                            SelectedItem="{Binding SelectedPalette}" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,14,4"
                        Orientation="Horizontal"
                        Visibility="{Binding HasDirections, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="{DynamicResource Str.ViewerDirection}" />
                        <ComboBox
                            MinWidth="56"
                            ItemsSource="{Binding Directions}"
                            SelectedIndex="{Binding SelectedDirection}" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,14,4"
                        Orientation="Horizontal"
                        Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding PreviousCommand, Mode=OneTime}" ToolTip="{DynamicResource Str.ViewerPreviousFrame}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE892;" />
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding PlayCommand, Mode=OneTime}"
                            ToolTip="{DynamicResource Str.ViewerPlay}">
                            <TextBlock FontFamily="{StaticResource IconFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding NextCommand, Mode=OneTime}"
                            ToolTip="{DynamicResource Str.ViewerNextFrame}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE893;" />
                        </Button>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding FrameLabel}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,14,4" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="{DynamicResource Str.ViewerZoom}" />
                        <ComboBox
                            MinWidth="76"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding ZoomOptions}"
                            SelectedItem="{Binding SelectedZoom}" />
                    </StackPanel>
                </WrapPanel>

                <!--  A picture with a palette of its own: can the game use it as an image of the ending? On a line of its own, with the toggle.  -->
                <WrapPanel Margin="0,0,0,4" Visibility="{Binding HasEnding, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        x:Name="EndingStatusPanel"
                        Margin="0,0,14,4"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        ToolTip="{Binding EndingTip}"
                        Visibility="{Binding HasEnding, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE711;" />
                                    <Setter Property="Foreground" Value="#E5484D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEndingUsable}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="#3FB950" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="{Binding EndingStatus}" />
                    </StackPanel>

                    <ToggleButton
                        x:Name="EndingTextToggle"
                        Margin="0,0,4,4"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ShowEndingText}"
                        ToolTip="{DynamicResource Str.ViewerEndingTextTip}"
                        Visibility="{Binding IsEndingUsable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                Text="&#xE8D2;" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str.ViewerEndingText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        x:Name="EndingTextAnother"
                        Margin="0,0,0,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Str.ViewerEndingAnother}"
                        Command="{Binding NewEndingTextCommand, Mode=OneTime}"
                        ToolTip="{DynamicResource Str.ViewerEndingAnother}"
                        Visibility="{Binding EndingTextVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B1;" />
                    </Button>
                </WrapPanel>
            </StackPanel>

            <Border
                Grid.Row="1"
                Background="{StaticResource CheckerBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        StretchDirection="Both"
                        Visibility="{Binding IsFit, Converter={StaticResource BoolToVisibility}}">
                        <!--  The text is in the pixels of the picture: it follows the magnification.  -->
                        <Grid>
                            <Image
                                behaviors:PixelImageSource.Image="{Binding Picture}"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                SnapsToDevicePixels="True" />
                            <Border
                                Width="{Binding EndingTextWidth}"
                                Margin="{Binding EndingTextLeft, Converter={StaticResource EndingTextMargin}}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="#CC000000"
                                Visibility="{Binding EndingTextVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Padding="4,2"
                                    FontFamily="Arial"
                                    FontSize="14"
                                    Foreground="White"
                                    Text="{Binding EndingText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Viewbox>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsFit, Converter={StaticResource InverseBoolToVisibility}}">
                        <Viewbox
                            Width="{Binding DisplayWidth}"
                            Height="{Binding DisplayHeight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Fill">
                            <Grid>
                                <Image
                                    behaviors:PixelImageSource.Image="{Binding Picture}"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    SnapsToDevicePixels="True" />
                                <Border
                                    Width="{Binding EndingTextWidth}"
                                    Margin="{Binding EndingTextLeft, Converter={StaticResource EndingTextMargin}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    Visibility="{Binding EndingTextVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Padding="4,2"
                                        FontFamily="Arial"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding EndingText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Viewbox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="2"
                Margin="0,6,0,0"
                Opacity="0.7"
                Text="{Binding Info}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  Sound: laid out like a movie, the button and the choice of the channels on top, the information at the bottom.  -->
        <Grid DataContext="{Binding Audio}" Visibility="{Binding DataContext.IsAudio, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  A wrap panel: in a narrow pane the volume and the repeat go to a second line instead of being cut.  -->
            <WrapPanel Margin="0,0,0,2">
                <Button
                    Margin="0,0,0,4"
                    Padding="16,6"
                    Command="{Binding PlayStopCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str.ViewerPlay}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str.ViewerPause}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <StackPanel
                    Margin="16,0,0,4"
                    Orientation="Horizontal"
                    Visibility="{Binding CanChooseChannels, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ToolbarLabel}" Text="{DynamicResource Str.ViewerChannels}" />
                    <ComboBox
                        MinWidth="120"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding ChannelChoices}"
                        SelectedItem="{Binding SelectedChannels}" />
                </StackPanel>

                <StackPanel
                    Margin="16,0,0,4"
                    Orientation="Horizontal"
                    Visibility="{Binding CanChangeVolume, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE767;"
                        ToolTip="{DynamicResource Str.ViewerVolume}" />
                    <Slider
                        Width="90"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Str.ViewerVolume}"
                        IsMoveToPointEnabled="True"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="5"
                        ToolTip="{DynamicResource Str.ViewerVolume}"
                        Value="{Binding Volume}" />
                </StackPanel>

                <ToggleButton
                    Margin="12,0,0,4"
                    Padding="10,6"
                    AutomationProperties.Name="{DynamicResource Str.ViewerLoop}"
                    IsChecked="{Binding IsLooping}"
                    ToolTip="{DynamicResource Str.ViewerLoop}">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Text="&#xE8EE;" />
                </ToggleButton>

                <TextBlock
                    Margin="12,0,0,4"
                    VerticalAlignment="Center"
                    Style="{StaticResource Notice}"
                    Text="{Binding Warning}" />
            </WrapPanel>

            <Grid
                x:Name="ShapeBox"
                Grid.Row="1"
                Height="110"
                Margin="8,0"
                VerticalAlignment="Center">
                <Path
                    Data="{Binding Envelope, Converter={StaticResource EnvelopeGeometry}}"
                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                    Stretch="Fill" />

                <!--  The mark of how far the sound has played.  -->
                <Rectangle
                    Width="2"
                    HorizontalAlignment="Left"
                    Fill="{DynamicResource TextFillColorPrimaryBrush}"
                    IsHitTestVisible="False"
                    Opacity="0.85">
                    <Rectangle.Margin>
                        <MultiBinding Converter="{StaticResource FractionOfWidth}">
                            <Binding Path="PlayedFraction" />
                            <Binding ElementName="ShapeBox" Path="ActualWidth" />
                            <Binding Path="Width" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Rectangle.Margin>
                </Rectangle>
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    IsMoveToPointEnabled="True"
                    LargeChange="1000"
                    Maximum="{Binding Maximum}"
                    Minimum="0"
                    SmallChange="100"
                    Thumb.DragCompleted="OnSeekCompleted"
                    Thumb.DragStarted="OnSeekStarted"
                    Value="{Binding Position, Delay=30}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.8"
                    Text="{Binding PositionText}" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="0,6,0,0"
                Opacity="0.7"
                Text="{Binding Info}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  Movie  -->
        <Grid DataContext="{Binding Video}" Visibility="{Binding DataContext.IsVideo, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <Button Padding="16,6" Command="{Binding PlayStopCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str.ViewerPlay}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str.ViewerPause}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Notice}"
                    Text="{Binding Warning}" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Background="Black"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Image
                            behaviors:PixelImageSource.Image="{Binding Frame}"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            SnapsToDevicePixels="True" />
                    </Viewbox>

                    <!--  The subtitle of the picture (the .sve file of the movie), at the bottom of the picture.  -->
                    <Border
                        Margin="24,0,24,16"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#B0000000"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="16"
                            Foreground="White"
                            Text="{Binding Subtitle}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    LargeChange="30"
                    Maximum="{Binding LastFrame}"
                    Minimum="0"
                    SmallChange="1"
                    Thumb.DragCompleted="OnSeekCompleted"
                    Thumb.DragStarted="OnSeekStarted"
                    TickFrequency="1"
                    Value="{Binding Position, Delay=30}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.8"
                    Text="{Binding PositionText}" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="0,6,0,0"
                Opacity="0.7"
                Text="{Binding Info}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  Character sheet  -->
        <ScrollViewer
            DataContext="{Binding Character}"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding DataContext.IsCharacter, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <!--  The scroll bar is drawn over the content: the sheet stops where it starts.  -->
            <ItemsControl
                Margin="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource RightMargin}}"
                ItemTemplate="{StaticResource SectionTemplate}"
                ItemsSource="{Binding Sections}" />
        </ScrollViewer>

        <!--  Prototype of an object  -->
        <ScrollViewer
            DataContext="{Binding Prototype}"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding DataContext.IsPrototype, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <!--  The scroll bar is drawn over the content: the sheet stops where it starts.  -->
            <ItemsControl
                Margin="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource RightMargin}}"
                ItemTemplate="{StaticResource SectionTemplate}"
                ItemsSource="{Binding Sections}" />
        </ScrollViewer>

        <!--  What a map holds  -->
        <ScrollViewer
            DataContext="{Binding Map}"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding DataContext.IsMap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <!--  The scroll bar is drawn over the content: the sheet stops where it starts.  -->
            <ItemsControl
                Margin="{Binding Width, Source={StaticResource ScrollBarMetrics}, Converter={StaticResource RightMargin}}"
                ItemTemplate="{StaticResource SectionTemplate}"
                ItemsSource="{Binding Sections}" />
        </ScrollViewer>

        <!--  Messages and dialogs  -->
        <Grid DataContext="{Binding Table}" Visibility="{Binding DataContext.IsTable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Notice}" Text="{Binding Notice}" />

            <DataGrid
                Grid.Row="1"
                AlternationCount="2"
                AutoGenerateColumns="True"
                AutoGeneratingColumn="OnAutoGeneratingColumn"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Rows}"
                RowStyle="{StaticResource StripedRow}"
                SelectionUnit="FullRow" />

            <TextBlock
                Grid.Row="2"
                Margin="0,6,0,0"
                Opacity="0.7"
                Text="{Binding Status}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>

</UserControl>