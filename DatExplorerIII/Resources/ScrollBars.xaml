<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="clr-namespace:DatExplorerIII.Services"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        The scroll bars of the program. The theme draws a thin slider that gets very small in a long list; these have a width and a
        smallest slider that the user chooses (Settings, General). The width is a resource that the program replaces when the settings
        change, and the smallest slider comes from ScrollBarMetrics.Current, so that every scroll bar follows at once.
    -->
    <sys:Double x:Key="ScrollBarSize">16</sys:Double>
    <services:ScrollBarViewportConverter x:Key="ScrollBarViewportConverter" />

    <!--  The arrow buttons at the ends, and the empty parts of the track that a click scrolls a page by.  -->
    <Style x:Key="ScrollBarArrowButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The slider: a rounded bar (its length comes from the track; the smallest one is kept by the viewport of the track).  -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="Bar"
                        Margin="3"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontal" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="Bar"
                        Margin="3"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RepeatButton
                Height="{DynamicResource ScrollBarSize}"
                Command="ScrollBar.LineUpCommand"
                Style="{StaticResource ScrollBarArrowButton}">
                <TextBlock
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="9"
                    Text="&#xE70E;" />
            </RepeatButton>

            <Track
                x:Name="PART_Track"
                Grid.Row="1"
                IsDirectionReversed="True">
                <Track.ViewportSize>
                    <MultiBinding Converter="{StaticResource ScrollBarViewportConverter}">
                        <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="MinimumThumb" Source="{x:Static services:ScrollBarMetrics.Current}" />
                    </MultiBinding>
                </Track.ViewportSize>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>

            <RepeatButton
                Grid.Row="2"
                Height="{DynamicResource ScrollBarSize}"
                Command="ScrollBar.LineDownCommand"
                Style="{StaticResource ScrollBarArrowButton}">
                <TextBlock
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="9"
                    Text="&#xE70D;" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RepeatButton
                Width="{DynamicResource ScrollBarSize}"
                Command="ScrollBar.LineLeftCommand"
                Style="{StaticResource ScrollBarArrowButton}">
                <TextBlock
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="9"
                    Text="&#xE76B;" />
            </RepeatButton>

            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.ViewportSize>
                    <MultiBinding Converter="{StaticResource ScrollBarViewportConverter}">
                        <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="MinimumThumb" Source="{x:Static services:ScrollBarMetrics.Current}" />
                    </MultiBinding>
                </Track.ViewportSize>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbHorizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>

            <RepeatButton
                Grid.Column="2"
                Width="{DynamicResource ScrollBarSize}"
                Command="ScrollBar.LineRightCommand"
                Style="{StaticResource ScrollBarArrowButton}">
                <TextBlock
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="9"
                    Text="&#xE76C;" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{DynamicResource ScrollBarSize}" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="{DynamicResource ScrollBarSize}" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
